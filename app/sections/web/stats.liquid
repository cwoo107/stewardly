<section class="site-section px-6 py-16 sm:px-12 lg:px-24">
  {% if settings.heading != blank %}<h2 class="site-heading mb-10 text-3xl font-semibold tracking-tight">{{ settings.heading | escape }}</h2>{% endif %}
  <dl class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {% for stat in settings.blocks %}
      <div class="flex flex-col border-t border-(--site-border) pt-6"><dt class="text-(--site-muted)">{{ stat.label | escape }}</dt><dd class="site-heading order-first text-5xl font-semibold tracking-tight">{{ stat.number | escape }}</dd></div>
    {% endfor %}
  </dl>
</section>
