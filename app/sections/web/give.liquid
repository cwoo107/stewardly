<section class="site-section bg-(--site-surface) px-6 py-16 text-center sm:px-12 lg:px-24">
  <h2 class="site-heading text-3xl font-semibold tracking-tight">{{ settings.heading | escape }}</h2>
  <div class="site-prose mt-4">{{ settings.body | markdown }}</div>
  {% if church.giving_url != blank %}<a href="{{ church.giving_url | escape }}" class="site-button mt-8 inline-block bg-(--site-brand) px-6 py-3 font-semibold text-white">{{ settings.button_label | escape }}</a>{% endif %}
</section>
