<section class="site-section px-6 py-16 sm:px-12 lg:px-24">
  <h2 class="site-heading text-3xl font-semibold tracking-tight">{{ settings.heading | escape }}</h2>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {% for service in service_times %}
      <li class="site-card p-6"><p class="text-2xl font-semibold">{{ service.day }} {{ service.time }}</p><p class="mt-1 text-(--site-muted)">{{ service.name | escape }}{% if service.campus != blank %} · {{ service.campus | escape }}{% endif %}</p></li>
    {% else %}
      <li class="text-(--site-muted)">Service times are coming soon.</li>
    {% endfor %}
  </ul>
  {% if settings.note != blank %}<p class="mt-6 text-(--site-muted)">{{ settings.note | escape }}</p>{% endif %}
</section>
