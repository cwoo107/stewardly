{% assign chosen = forms[settings.form] %}
{% if chosen %}
<section class="site-section px-6 py-16 sm:px-12 lg:px-24">
  <h2 class="site-heading text-3xl font-semibold tracking-tight">{{ settings.heading | default: chosen.name | escape }}</h2>
  {% if chosen.description != blank %}<p class="mt-3 text-(--site-muted)">{{ chosen.description | escape }}</p>{% endif %}
  <div class="site-form mt-8">{{ chosen.html }}</div>
</section>
{% endif %}
