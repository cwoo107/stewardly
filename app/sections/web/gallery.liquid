<section class="site-section px-6 py-16 sm:px-12 lg:px-24">
  {% if settings.heading != blank %}<h2 class="site-heading mb-8 text-3xl font-semibold tracking-tight">{{ settings.heading | escape }}</h2>{% endif %}
  <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
    {% for photo in settings.blocks %}{% if photo.image_url != blank %}<img src="{{ photo.image_url | escape }}" alt="{{ photo.alt | escape }}" class="site-radius aspect-square w-full object-cover" loading="lazy">{% endif %}{% endfor %}
  </div>
</section>
