<section class="site-section px-6 py-16 sm:px-12 lg:px-24">
  <h2 class="site-heading text-3xl font-semibold tracking-tight">{{ settings.heading | escape }}</h2>
  <div class="mt-8 divide-y divide-(--site-border)">
    {% for item in settings.blocks %}
      <details class="py-4"><summary class="cursor-pointer text-lg font-medium">{{ item.question | escape }}</summary><div class="site-prose mt-3">{{ item.answer | markdown }}</div></details>
    {% endfor %}
  </div>
</section>
