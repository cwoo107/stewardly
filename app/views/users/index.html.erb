<% content_for :title, "Users" %>
<%= render "shared/page_header", title: "Users", subtitle: "People who can sign in to #{Current.church.name}." %>

<div class="overflow-hidden rounded-4xl bg-white shadow-sm ring-1 ring-gray-200">
  <ul role="list" class="divide-y divide-gray-100">
    <% @users.each do |user| %>
      <li>
        <%= link_to user, class: "flex flex-wrap items-center justify-between gap-2 px-6 py-4 hover:bg-gray-50" do %>
          <div class="min-w-0">
            <p class="font-medium text-gray-900"><%= user.name %></p>
            <p class="truncate text-sm text-gray-500"><%= user.email_address %></p>
          </div>
          <div class="flex flex-wrap gap-2">
            <% user.roles.sort_by(&:name).each do |role| %>
              <span class="rounded-full bg-cyan-50 px-2.5 py-0.5 text-xs font-medium text-cyan-900"><%= role.name %></span>
            <% end %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
