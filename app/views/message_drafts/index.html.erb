<% content_for :title, "Approvals" %>
<%= render "shared/page_header", title: "Approvals", subtitle: "Messages workflows wrote for people. Nothing here goes out until someone approves it." %>
<nav class="mb-6 flex flex-wrap gap-2 text-sm" aria-label="Filter">
  <% { "pending" => "Waiting", "sent" => "Sent", "rejected" => "Not sent" }.each do |status, label| %>
    <%= link_to label, message_drafts_path(status:), class: "rounded-full px-3 py-1 #{@status == status ? "bg-gray-900 text-white" : "bg-white ring-1 ring-gray-200"}" %>
  <% end %>
</nav>

<ul role="list" class="space-y-4">
  <% @drafts.each do |draft| %>
    <li class="<%= card_classes %>">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-sm text-gray-500">To <%= link_to draft.person.name, draft.person, class: "underline" %> · <%= draft.workflow_run.workflow.name %> · <%= time_ago_in_words(draft.created_at) %> ago</p>
          <h2 class="mt-1 font-semibold"><%= draft.subject %></h2>
          <% if draft.body.present? %>
            <p class="mt-2 whitespace-pre-line text-sm text-gray-700"><%= draft.body.truncate(400) %></p>
          <% else %>
            <p class="mt-2 text-sm text-amber-800"><%= draft.note || "Needs writing." %></p>
          <% end %>
          <p class="mt-2 text-xs text-gray-500">
            <%= draft.source_ai? ? "Drafted by AI" : "Needs a person to write it" %>
            <% if draft.reviewed_at %> · <%= draft.auto_sent ? "sent automatically" : "#{draft.status} by #{draft.reviewed_by&.name}" %> <%= time_ago_in_words(draft.reviewed_at) %> ago<% end %>
          </p>
        </div>
        <% if draft.pending? %>
          <span class="flex gap-2">
            <%= link_to "Review", edit_message_draft_path(draft), class: button_classes(:primary) %>
            <%= button_to "Don't send", reject_message_draft_path(draft), method: :patch, class: button_classes(:outline) %>
          </span>
        <% end %>
      </div>
    </li>
  <% end %>
</ul>
<% if @drafts.empty? %><p class="<%= card_classes %> text-sm text-gray-500">Nothing here.</p><% end %>
<%= render "shared/pagination", pagy: @pagy %>
