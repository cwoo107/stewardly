<ol class="mt-3 space-y-2 text-sm">
  <% forecast.factors.each_with_index do |factor, index| %>
    <li class="flex items-start justify-between gap-4">
      <span>
        <span class="font-medium"><%= factor["label"] %></span>
        <span class="block text-xs text-gray-500"><%= factor["detail"] %></span>
      </span>
      <span class="shrink-0 tabular-nums <%= "text-gray-500" if index.positive? %>">
        <%= index.zero? ? number_with_delimiter(factor["effect"].round) : format("%+d", factor["effect"].round) %>
      </span>
    </li>
  <% end %>
  <li class="flex justify-between gap-4 border-t border-gray-100 pt-2 font-semibold"><span>Forecast</span><span class="tabular-nums"><%= number_with_delimiter(forecast.expected) %></span></li>
</ol>
