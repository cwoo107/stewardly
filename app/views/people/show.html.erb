<% content_for :title, @person.name %>
<%= render "shared/page_header", title: @person.name, subtitle: [ @person.membership_status.humanize, (@person.age && "#{@person.age} years old") ].compact.join(" · ") do %>
  <div class="flex flex-wrap gap-2">
    <% if policy(@person).invite? %>
      <%= button_to "Give member area access", person_account_invitation_path(@person), class: button_classes(:outline),
            form: { data: { turbo_confirm: "Email #{@person.first_name} a link to set up their account?" } } %>
    <% end %>
    <%= link_to "Edit", edit_person_path(@person), class: button_classes(:outline) if policy(@person).update? %>
    <% if policy(@person).destroy? %>
      <%= button_to "Delete", @person, method: :delete, class: button_classes(:danger),
            form: { data: { turbo_confirm: "Delete #{@person.name}? Their contact history, tags, and memberships will be deleted too." } } %>
    <% end %>
  </div>
<% end %>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-1">
    <section class="<%= card_classes %>">
      <h2 class="text-lg font-semibold">Contact</h2>
      <dl class="mt-4 space-y-3 text-sm">
        <div><dt class="text-gray-500">Email</dt><dd><%= @person.email.presence || "—" %></dd></div>
        <div><dt class="text-gray-500">Phone</dt><dd><%= @person.phone.presence || "—" %></dd></div>
        <div><dt class="text-gray-500">Birthdate</dt><dd><%= @person.birthdate ? l(@person.birthdate, format: :long) : "—" %></dd></div>
        <div>
          <dt class="text-gray-500">Household</dt>
          <dd><%= @person.household ? link_to(@person.household.name, @person.household, class: "hover:underline") : "—" %></dd>
        </div>
        <% CustomField.ordered.each do |field| %>
          <% if (value = field.display(@person.custom_field_value(field))).present? %>
            <div><dt class="text-gray-500"><%= field.label %></dt><dd><%= value %></dd></div>
          <% end %>
        <% end %>
      </dl>
      <% if @person.tags.any? %>
        <div class="mt-4 flex flex-wrap gap-2"><% @person.tags.sort_by(&:name).each { |tag| %><%= tag_badge(tag) %><% } %></div>
      <% end %>
    </section>

    <% if (placement = @person.pathway_placement) %>
      <section class="<%= card_classes %>">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold">Pathway</h2>
          <%= badge("Stuck", color: "amber") if placement.stuck? %>
        </div>
        <p class="mt-2 text-2xl font-semibold"><%= placement.pathway_stage.name %></p>
        <p class="text-sm text-gray-600">for <%= pluralize(placement.days_in_stage, "day") %></p>
        <ol class="mt-4 space-y-1 text-sm">
          <% @person.pathway_transitions.includes(:from_stage, :to_stage).first(6).each do |transition| %>
            <li class="text-gray-600">
              <%= l(transition.occurred_at.to_date, format: :long) %>:
              <%= transition.placed? ? "started at #{transition.to_stage.name}" : "#{transition.forward? ? "moved on" : "moved back"} to #{transition.to_stage.name}" %>
            </li>
          <% end %>
        </ol>
      </section>
    <% end %>

    <section class="<%= card_classes %>">
      <h2 class="text-lg font-semibold">Groups and teams</h2>
      <ul role="list" class="mt-4 space-y-2 text-sm">
        <% @person.groups.each do |group| %>
          <li><%= link_to group.name, group, class: "hover:underline" %> <span class="text-gray-500">· <%= group.group_type.humanize %></span></li>
        <% end %>
        <% @person.teams.each do |team| %>
          <li><%= link_to team.name, team, class: "hover:underline" %> <span class="text-gray-500">· <%= team.ministry.name %> team</span></li>
        <% end %>
        <% if @person.groups.empty? && @person.teams.empty? %>
          <li class="text-gray-500">Not in any group or team yet.</li>
        <% end %>
      </ul>
    </section>

    <% if @prayer_requests %>
      <section class="<%= card_classes %>">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold">Prayer requests</h2>
          <%= link_to "Add", new_prayer_request_path(person_id: @person.id), class: "text-sm text-cyan-700 hover:underline" if policy(PrayerRequest).create? %>
        </div>
        <ul role="list" class="mt-4 space-y-2 text-sm">
          <% @prayer_requests.each do |request| %>
            <li><%= link_to truncate(request.body, length: 60), request, class: "hover:underline" %> <span class="text-gray-500">· <%= request.status.humanize %></span></li>
          <% end %>
          <% if @prayer_requests.empty? %><li class="text-gray-500">None.</li><% end %>
        </ul>
      </section>
    <% end %>

    <% if @giving %>
      <section class="<%= card_classes %>">
        <h2 class="text-lg font-semibold">Giving</h2>
        <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <div><dt class="text-gray-500">This year</dt><dd class="font-semibold"><%= Money.format(@giving.this_year_cents) %></dd></div>
          <div><dt class="text-gray-500">Last year</dt><dd class="font-semibold"><%= Money.format(@giving.last_year_cents) %></dd></div>
        </dl>
        <p class="mt-3 text-sm text-gray-600"><%= @giving.last_gift ? "Last gift #{l(@giving.last_gift.given_on, format: :long)}" : "No gifts on record." %>
          <%= link_to "See gifts", donations_path(q: @person.name), class: "underline" if @giving.last_gift %></p>
      </section>
    <% end %>

    <% if @benevolence_cases %>
      <section class="<%= card_classes %>">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold">Benevolence</h2>
          <%= link_to "Open a case", new_benevolence_case_path(person_id: @person.id), class: "text-sm text-cyan-700 hover:underline" if policy(BenevolenceCase).create? %>
        </div>
        <ul role="list" class="mt-4 space-y-2 text-sm">
          <% @benevolence_cases.each do |kase| %>
            <li><%= link_to kase.need_label, kase, class: "hover:underline" %> <span class="text-gray-500">· <%= kase.status.humanize %> · <%= l(kase.created_at.to_date, format: :long) %></span></li>
          <% end %>
          <% if @benevolence_cases.empty? %><li class="text-gray-500">None.</li><% end %>
        </ul>
      </section>
    <% end %>

    <% if @workflow_runs %>
      <section class="<%= card_classes %>">
        <h2 class="text-lg font-semibold">Workflows</h2>
        <ul role="list" class="mt-4 space-y-2 text-sm">
          <% @workflow_runs.each do |run| %>
            <li class="flex items-center justify-between gap-2">
              <%= link_to run.workflow.name, workflow_run_path(run.workflow, run), class: "hover:underline" %>
              <%= run_status_badge(run) %>
            </li>
          <% end %>
          <% if @workflow_runs.empty? %><li class="text-gray-500">None yet.</li><% end %>
        </ul>
      </section>
    <% end %>
  </div>

  <section class="<%= card_classes %> lg:col-span-2">
    <h2 class="text-lg font-semibold">Timeline</h2>

    <% if policy(Touchpoint.new(person: @person)).create? %>
      <%= form_with model: Touchpoint.new(kind: "note"), url: person_touchpoints_path(@person), class: "mt-4 space-y-3 rounded-2xl bg-gray-50 p-4" do |form| %>
        <div class="grid gap-3 sm:grid-cols-[auto_1fr]">
          <%= form.select :kind, Touchpoint::MANUAL_KINDS.map { |k| [ k.humanize, k ] }, {}, class: select_classes, aria: { label: "Kind" } %>
          <%= form.text_field :summary, placeholder: "What happened?", required: true, class: input_classes, aria: { label: "Summary" } %>
        </div>
        <%= form.text_area :body, rows: 2, placeholder: "Notes (optional, stored encrypted)", class: input_classes, aria: { label: "Notes" } %>
        <%= form.submit "Log contact", class: button_classes(:primary) %>
      <% end %>
    <% end %>

    <ol role="list" class="mt-6 space-y-5">
      <% @touchpoints.each do |touchpoint| %>
        <li id="<%= dom_id(touchpoint) %>" class="border-l-2 border-cyan-100 pl-4">
          <p class="text-sm">
            <span class="font-medium"><%= touchpoint.summary %></span>
            <span class="text-gray-500">· <%= touchpoint.kind.humanize %></span>
          </p>
          <% if touchpoint.body.present? && policy(touchpoint).show_body? %>
            <p class="mt-1 whitespace-pre-line text-sm text-gray-700"><%= touchpoint.body %></p>
          <% end %>
          <p class="mt-1 text-xs text-gray-500">
            <%= l(touchpoint.occurred_at, format: :short) %><%= " · #{touchpoint.author.name}" if touchpoint.author %>
          </p>
        </li>
      <% end %>
      <% if @touchpoints.empty? %>
        <li class="text-sm text-gray-500">No contact recorded yet.</li>
      <% end %>
    </ol>
  </section>
</div>
