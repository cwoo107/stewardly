<%= turbo_frame_tag "person_search" do %>
  <ul role="list" class="mt-3 divide-y divide-gray-100 rounded-2xl bg-gray-50">
    <% @people.each do |person| %>
      <li class="flex items-center justify-between gap-3 px-4 py-2 text-sm">
        <span><%= person.name %> <span class="text-gray-500"><%= person.email %></span></span>
        <% case @target %>
        <% when Group %>
          <%= button_to "Add", group_group_memberships_path(@target), params: { group_membership: { person_id: person.id } }, class: button_classes(:outline), form: { data: { turbo_frame: "_top" } } %>
        <% when Team %>
          <%= button_to "Add", team_team_memberships_path(@target), params: { team_membership: { person_id: person.id } }, class: button_classes(:outline), form: { data: { turbo_frame: "_top" } } %>
        <% end %>
      </li>
    <% end %>
    <% if @people.empty? %>
      <li class="px-4 py-2 text-sm text-gray-500"><%= params[:q].to_s.strip.length >= 2 ? "No matches." : "Type at least two letters." %></li>
    <% end %>
  </ul>
<% end %>
