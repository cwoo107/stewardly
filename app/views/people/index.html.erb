<% content_for :title, "People" %>
<%= render "shared/page_header", title: "People", subtitle: @segment ? "In the segment “#{@segment.name}”" : nil do %>
  <div class="flex flex-wrap gap-2">
    <% if policy(PersonImport).create? %>
      <%= link_to "Import", person_imports_path, class: button_classes(:outline) %>
      <%= link_to "Duplicates", duplicates_path, class: button_classes(:outline) %>
    <% end %>
    <%= link_to "Add person", new_person_path, class: button_classes(:primary) if policy(Person).create? %>
  </div>
<% end %>

<%= form_with url: people_path, method: :get, class: "mb-6 grid gap-3 sm:grid-cols-[1fr_auto_auto_auto_auto]", data: { turbo_action: "replace" } do |form| %>
  <%= form.search_field :q, value: params[:q], placeholder: "Search name, email, or phone", class: input_classes, aria: { label: "Search" } %>
  <%= form.select :segment_id, options_from_collection_for_select(policy_scope(Segment).alphabetical, :id, :name, params[:segment_id]),
        { include_blank: "Any segment" }, class: select_classes, aria: { label: "Segment" } %>
  <%= form.select :tag_id, options_from_collection_for_select(Tag.alphabetical, :id, :name, params[:tag_id]),
        { include_blank: "Any tag" }, class: select_classes, aria: { label: "Tag" } %>
  <%= form.select :status, options_for_select(Person.membership_statuses.keys.map { |s| [ s.humanize, s ] }, params[:status]),
        { include_blank: "Any status" }, class: select_classes, aria: { label: "Membership status" } %>
  <%= form.submit "Filter", class: button_classes(:secondary) %>
<% end %>

<div class="overflow-hidden rounded-4xl bg-white shadow-sm ring-1 ring-gray-200">
  <ul role="list" class="divide-y divide-gray-100">
    <% @people.each do |person| %>
      <li id="<%= dom_id(person) %>">
        <%= link_to person, class: "flex flex-wrap items-center justify-between gap-2 px-6 py-4 hover:bg-gray-50" do %>
          <div class="min-w-0">
            <p class="font-medium text-gray-900"><%= person.name %></p>
            <p class="truncate text-sm text-gray-500"><%= [ person.email, person.phone, person.household&.name ].compact_blank.join(" · ") %></p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <%= badge(person.membership_status.humanize) %>
            <% person.tags.sort_by(&:name).each { |tag| %><%= tag_badge(tag) %><% } %>
          </div>
        <% end %>
      </li>
    <% end %>
    <% if @people.empty? %>
      <li class="px-6 py-8 text-center text-sm text-gray-500">No one matches.</li>
    <% end %>
  </ul>
</div>
<%= render "shared/pagination", pagy: @pagy %>
