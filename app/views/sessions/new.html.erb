<% content_for :title, "Sign in to #{Current.church.name}" %>

<%= form_with url: session_url, class: "space-y-6" do |form| %>
  <div>
    <%= form.label :email_address, "Email address", class: label_classes %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: input_classes %>
  </div>

  <div>
    <%= form.label :password, class: label_classes %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: input_classes %>
  </div>

  <div class="flex items-center justify-between gap-4">
    <%= form.submit "Sign in", class: button_classes(:primary) %>
    <%= link_to "Forgot password?", new_password_path, class: "text-sm text-gray-600 underline hover:no-underline" %>
  </div>
<% end %>

<p class="mt-8 border-t border-gray-100 pt-6 text-center text-sm text-gray-600">
  New here? <%= link_to "Create your account", new_account_setup_path, class: "font-semibold text-cyan-700 hover:underline" %>
</p>
