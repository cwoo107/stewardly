<% content_for :title, "Giving settings" %>
<%= render "shared/page_header", title: "Giving settings" %>
<%= render "shared/giving_nav" %>

<div class="grid gap-8 lg:grid-cols-2">
  <section class="<%= card_classes %> space-y-4" aria-labelledby="provider_heading">
    <div class="flex items-center justify-between gap-3">
      <h2 id="provider_heading" class="font-semibold">Giving platform</h2>
      <%= badge(@integration ? "#{@integration.label} connected" : "Not connected", color: @integration ? "green" : "gray") %>
    </div>
    <p class="rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">
      The Tithe.ly connection is waiting on Tithe.ly's API documentation, so syncing and webhooks won't work yet.
      Everything else (matching, the review queue, reports) is ready for when it does.
    </p>
    <% if policy(Integration).update? %>
      <% record = @integration || Integration.new(category: "giving", provider: "tithely") %>
      <%= form_with model: record, url: record.persisted? ? integration_path(record) : integrations_path, class: "space-y-4" do |form| %>
        <%= form.hidden_field :category %>
        <%= form.hidden_field :provider %>
        <% Integration::FIELDS.fetch("tithely")[:credentials].each do |key| %>
          <div>
            <%= label_tag "integration_credentials_#{key}", key.humanize, class: label_classes %>
            <%= password_field_tag "integration[credentials][#{key}]", nil, id: "integration_credentials_#{key}", autocomplete: "off",
                  placeholder: record.credential(key) ? "Saved (leave blank to keep)" : "", class: input_classes %>
          </div>
        <% end %>
        <% Integration::FIELDS.fetch("tithely")[:settings].each do |key| %>
          <div>
            <%= label_tag "integration_settings_#{key}", key.humanize, class: label_classes %>
            <%= text_field_tag "integration[settings][#{key}]", record.setting(key), id: "integration_settings_#{key}", class: input_classes %>
          </div>
        <% end %>
        <%= form.submit record.persisted? ? "Save" : "Connect Tithe.ly", class: button_classes(:primary) %>
      <% end %>
      <% if @integration %>
        <div class="rounded-lg bg-gray-50 p-4 text-sm">
          <p class="font-semibold">Webhook URL</p>
          <code class="mt-2 block break-all rounded bg-white p-2 text-xs ring-1 ring-gray-200"><%= "#{Email::Tracking.base_url(Current.church)}#{webhook_path(@integration.webhook_token)}" %></code>
        </div>
        <%= button_to "Disconnect #{@integration.label}", integration_path(@integration), method: :delete, class: button_classes(:danger),
              form: { data: { turbo_confirm: "Disconnect #{@integration.label}? Synced donations stay; its saved credentials are deleted." } } %>
      <% end %>
    <% else %>
      <p class="text-sm text-gray-500">Someone with the “Connect outside services” permission can set this up.</p>
    <% end %>
  </section>

  <section class="<%= card_classes %> space-y-4" aria-labelledby="sync_heading">
    <div class="flex items-center justify-between gap-3">
      <h2 id="sync_heading" class="font-semibold">Syncing</h2>
      <%= button_to "Sync now", sync_giving_settings_path, class: button_classes(:outline) if @integration&.active? && policy(:giving_settings).sync? %>
    </div>
    <p class="text-sm text-gray-600">New gifts arrive by webhook; every night at 2am the last week is fetched again to catch anything missed.</p>
    <ul role="list" class="divide-y divide-gray-100 text-sm">
      <% @runs.each do |run| %>
        <li class="py-2">
          <span class="font-medium"><%= run.kind.humanize %></span> · <%= l(run.created_at, format: :short) %>
          <%= badge run.status.humanize, color: { "succeeded" => "green", "failed" => "rose" }.fetch(run.status, "gray") %>
          <span class="block text-gray-600"><%= run.created_count %> new, <%= run.updated_count %> updated, <%= run.matched_count %> matched, <%= run.unmatched_count %> to review</span>
          <% if run.error %><span class="block text-rose-700"><%= run.error %></span><% end %>
        </li>
      <% end %>
      <% if @runs.empty? %><li class="py-2 text-gray-500">No syncs yet.</li><% end %>
    </ul>
  </section>
</div>
