<% content_for :title, "Projects" %>
<%= render "shared/page_header", title: "Projects" do %>
  <div class="flex gap-2">
    <%= link_to "Tasks", tasks_path, class: button_classes(:outline) %>
    <%= link_to "New project", new_project_path, class: button_classes(:primary) %>
  </div>
<% end %>

<div class="overflow-hidden rounded-4xl bg-white shadow-sm ring-1 ring-gray-200">
  <ul role="list" class="divide-y divide-gray-100">
    <% @projects.each do |project| %>
      <li class="flex flex-wrap items-center justify-between gap-3 px-6 py-3">
        <div>
          <%= link_to project.name, tasks_path(project_id: project.id), class: "font-medium hover:underline #{"text-gray-400" if project.archived?}" %>
          <%= badge("Archived") if project.archived? %>
          <p class="text-sm text-gray-500"><%= pluralize(project.open_tasks_count, "open task") %></p>
        </div>
        <span class="flex gap-2">
          <%= link_to "Edit", edit_project_path(project), class: button_classes(:outline) %>
          <%= button_to project.archived? ? "Unarchive" : "Archive", project_path(project), method: :patch, params: { archive: project.archived? ? "0" : "1" }, class: button_classes(:outline) %>
        </span>
      </li>
    <% end %>
    <% if @projects.empty? %><li class="px-6 py-6 text-sm text-gray-500">No projects yet.</li><% end %>
  </ul>
</div>
