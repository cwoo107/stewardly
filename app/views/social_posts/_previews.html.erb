<%# How the saved post looks on each network. %>
<% photo = post.media.first %>
<div class="space-y-6">
  <% post.targets.includes(:social_account).each do |target| %>
    <% account = target.social_account %>
    <div>
      <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-500"><%= account.label %></p>
      <% if account.instagram? %>
        <div class="overflow-hidden rounded-xl bg-white ring-1 ring-gray-200">
          <div class="flex items-center gap-2 px-3 py-2 text-sm font-semibold"><span class="h-7 w-7 rounded-full bg-gradient-to-tr from-amber-400 to-fuchsia-600"></span><%= account.handle || account.name %></div>
          <% if photo %><%= image_tag photo, alt: "", class: "aspect-square w-full object-cover" %><% else %><div class="flex aspect-square items-center justify-center bg-gray-100 text-sm text-gray-500">Instagram needs a photo</div><% end %>
          <p class="whitespace-pre-line px-3 py-3 text-sm"><span class="font-semibold"><%= account.handle || account.name %></span> <%= target.caption_text.truncate(220) %><%= "\n\nLink in bio: #{post.link_url}" if post.link_url.present? %></p>
        </div>
      <% else %>
        <div class="overflow-hidden rounded-xl bg-white ring-1 ring-gray-200">
          <div class="flex items-center gap-2 px-3 py-3 text-sm"><span class="h-9 w-9 rounded-full bg-blue-600"></span><span><span class="block font-semibold"><%= account.name %></span><span class="text-xs text-gray-500"><%= social_when(post) %></span></span></div>
          <p class="whitespace-pre-line px-3 pb-3 text-sm"><%= target.caption_text %></p>
          <% if photo %><%= image_tag photo, alt: "", class: "w-full object-cover" %>
          <% elsif post.link_url.present? %><div class="border-t border-gray-100 bg-gray-50 px-3 py-3 text-xs text-gray-600"><%= URI.parse(post.link_url).host rescue post.link_url %></div><% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <% if post.targets.empty? %><p class="text-sm text-gray-500">Choose an account to see a preview.</p><% end %>
</div>
