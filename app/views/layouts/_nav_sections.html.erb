<%# Top links, then one collapsible <details> per section (native keyboard support, works without JavaScript). %>
<div class="space-y-1">
  <% navigation_top_links.each do |link| %>
    <%= link_to link.label, link.path, class: nav_link_class(link.path) %>
  <% end %>
</div>
<div class="mt-4 space-y-1" data-controller="nav-sections">
  <% navigation_sections.each do |section| %>
    <details class="group/section" data-nav-sections-target="section" data-key="<%= section.key %>"
             data-active="<%= section.active %>" <%= "open" if section.active %>>
      <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 text-xs font-semibold uppercase tracking-wide text-gray-500 hover:bg-gray-50 hover:text-gray-700 [&::-webkit-details-marker]:hidden">
        <%= section.heading %>
        <svg class="h-4 w-4 text-gray-400 transition-transform group-open/section:rotate-90" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M7.2 5.2a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06L8.26 14.8a.75.75 0 1 1-1.06-1.06L10.94 10 7.2 6.26a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
        </svg>
      </summary>
      <div class="mb-2 space-y-1 pl-2">
        <% section.links.each do |link| %>
          <%= link_to link.label, link.path, class: nav_link_class(link.path) %>
        <% end %>
      </div>
    </details>
  <% end %>
</div>
