<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50 antialiased">
  <head>
    <%= render "layouts/head", suffix: "Stewardly platform" %>
  </head>

  <body class="h-full font-sans text-gray-900">
    <% if Current.platform_admin %>
      <header class="border-b border-gray-200 bg-white">
        <div class="flex items-center justify-between px-4 py-4 sm:px-6">
          <div class="flex items-center gap-3">
            <%= render "shared/logo", class: "h-7 w-7" %>
            <span class="font-semibold">Stewardly platform</span>
          </div>
          <nav class="flex items-center gap-4 text-sm text-gray-700">
            <%= link_to "Churches", platform_churches_path, class: "hover:text-gray-900" %>
            <%= link_to "Sidekiq", "/sidekiq", class: "hover:text-gray-900", data: { turbo: false } %>
            <%= button_to "Sign out", platform_session_path, method: :delete, class: "underline hover:no-underline cursor-pointer" %>
          </nav>
        </div>
      </header>
    <% end %>

    <main class="px-4 py-8 sm:px-6 lg:py-10">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
