<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50 antialiased">
  <head>
    <%= render "layouts/head", suffix: Current.church&.name %>
  </head>

  <body class="h-full font-sans text-gray-900">
    <div class="min-h-full lg:flex">
      <%= render "layouts/navigation" %>

      <main class="flex-1 px-4 py-8 sm:px-6 lg:px-10 lg:py-10">
        <div>
          <div id="flash"><%= render "shared/flash" %></div>
          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
