<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50 antialiased">
  <head>
    <%= render "layouts/head", suffix: Current.church&.name %>
    <meta name="robots" content="noindex">
  </head>

  <body class="min-h-full font-sans text-gray-900">
    <header class="border-b border-gray-200 bg-white">
      <div class="flex items-center gap-3 px-4 py-4">
        <%= render "shared/logo", class: "h-7 w-7" %>
        <span class="font-semibold"><%= Current.church.name %></span>
      </div>
    </header>
    <main class="px-4 py-8 sm:py-12">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
