<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50 antialiased">
  <head>
    <%= render "layouts/head", suffix: Current.church&.name %>
  </head>

  <body class="h-full font-sans text-gray-900">
    <%# Pocket AuthLayout %>
    <main class="flex min-h-full overflow-hidden pt-16 sm:py-28">
      <div class="flex w-full flex-col px-4 sm:px-6">
        <div class="flex justify-center"><%= render "shared/logo", class: "h-10 w-10" %></div>
        <div class="relative mt-12 sm:mt-16">
          <h1 class="text-center text-2xl font-medium tracking-tight text-gray-900"><%= content_for(:title) %></h1>
          <% if content_for?(:subtitle) %>
            <p class="mt-3 text-center text-lg text-gray-600"><%= content_for(:subtitle) %></p>
          <% end %>
        </div>
        <div class="-mx-4 mt-10 flex-auto bg-white px-4 py-10 shadow-2xl shadow-gray-900/10 sm:mx-0 sm:flex-none sm:rounded-5xl sm:p-24">
          <%= render "shared/flash" %>
          <%= yield %>
        </div>
      </div>
    </main>
  </body>
</html>
