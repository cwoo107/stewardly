<%
  sections = [
    [ nil, [
      [ "Dashboard", root_path, policy(:dashboard).show? ],
      [ "Calendar", calendar_path, policy(:calendar).show? ],
      [ "Member area", member_root_path, true ]
    ] ],
    [ "People", [
      [ "People", people_path, policy(Person).index? ],
      [ "Households", households_path, policy(Household).index? ],
      [ "Segments", segments_path, policy(Segment).index? ],
      [ "Map", map_path, policy(:map).show? ]
    ] ],
    [ "Organization", [
      [ "Ministries", ministries_path, policy(Ministry).index? ],
      [ "Groups", groups_path, policy(Group).index? ]
    ] ],
    [ "Attendance", [
      [ "Attendance", attendance_path, policy(:attendance).show? ],
      [ "Enter counts", attendance_counts_path, policy(:attendance).record? && !policy(:attendance).show? ]
    ] ],
    [ "Serving & events", [
      [ "Services", worship_services_path, policy(WorshipService).index? ],
      [ "Events", events_path, policy(Event).index? ],
      [ "Courses", courses_path, policy(Course).index? ],
      [ "Updates", announcements_path, policy(Announcement).index? ]
    ] ],
    [ "Care & work", [
      [ "Prayer requests", prayer_requests_path, policy(PrayerRequest).index? ],
      [ "Forms", forms_path, policy(Form).index? ],
      [ "Tasks", tasks_path, policy(Task).index? ]
    ] ],
    [ "Admin", [
      [ "Users", users_path, policy(User).index? ],
      [ "Roles", roles_path, policy(Role).index? ],
      [ "Audit log", audit_events_path, policy(AuditEvent).index? ],
      [ "Settings", edit_church_settings_path, policy(Current.church).edit? ]
    ] ]
  ].map { |heading, links| [ heading, links.select(&:last) ] }.reject { |_, links| links.empty? }

  link_class = ->(path) {
    active = request.path == path || (path != root_path && request.path.start_with?(path))
    "block rounded-lg px-3 py-2 text-sm #{active ? "bg-gray-100 font-semibold text-gray-900" : "text-gray-700 hover:bg-gray-50"}"
  }
%>
<%# A <details> element gives the mobile menu its toggle without any JavaScript. %>
<details class="group border-b border-gray-200 bg-white lg:hidden">
  <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3">
    <span class="flex items-center gap-3">
      <%= render "shared/logo", class: "h-7 w-7" %>
      <span class="font-semibold"><%= Current.church.name %></span>
    </span>
    <span class="text-sm text-gray-600 group-open:hidden">Menu</span>
    <span class="hidden text-sm text-gray-600 group-open:inline">Close</span>
  </summary>
  <nav class="space-y-4 px-2 pb-4" aria-label="Main">
    <% sections.each do |heading, links| %>
      <div class="space-y-1">
        <% if heading %><p class="px-3 text-xs font-semibold uppercase tracking-wide text-gray-400"><%= heading %></p><% end %>
        <% links.each do |label, path, _| %>
          <%= link_to label, path, class: link_class.(path) %>
        <% end %>
      </div>
    <% end %>
    <%= button_to "Sign out", session_path, method: :delete, class: "block w-full rounded-lg px-3 py-2 text-left text-sm text-gray-700 hover:bg-gray-50" %>
  </nav>
</details>

<aside class="hidden w-64 shrink-0 flex-col border-r border-gray-200 bg-white lg:flex">
  <div class="flex items-center gap-3 px-6 py-6">
    <%= render "shared/logo", class: "h-8 w-8" %>
    <span class="font-semibold leading-tight"><%= Current.church.name %></span>
  </div>
  <nav class="flex-1 space-y-5 px-3" aria-label="Main">
    <% sections.each do |heading, links| %>
      <div class="space-y-1">
        <% if heading %><p class="px-3 text-xs font-semibold uppercase tracking-wide text-gray-400"><%= heading %></p><% end %>
        <% links.each do |label, path, _| %>
          <%= link_to label, path, class: link_class.(path) %>
        <% end %>
      </div>
    <% end %>
  </nav>
  <div class="border-t border-gray-200 px-6 py-4">
    <p class="truncate text-sm font-medium"><%= Current.user.name %></p>
    <p class="truncate text-xs text-gray-500"><%= Current.user.email_address %></p>
    <%= button_to "Sign out", session_path, method: :delete, class: "mt-3 text-sm text-gray-600 underline hover:no-underline cursor-pointer" %>
  </div>
</aside>
