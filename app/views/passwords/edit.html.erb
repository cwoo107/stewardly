<% content_for :title, "Choose a new password" %>

<%= form_with url: password_path(params[:token]), method: :put, class: "space-y-6" do |form| %>
  <div>
    <%= form.label :password, "New password", class: label_classes %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: input_classes %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Repeat new password", class: label_classes %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: input_classes %>
  </div>

  <%= form.submit "Save", class: button_classes(:primary) %>
<% end %>
