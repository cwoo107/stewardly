<% content_for :title, "Forgot your password?" %>
<% content_for :subtitle, "We’ll email you a link to reset it." %>

<%= form_with url: passwords_path, class: "space-y-6" do |form| %>
  <div>
    <%= form.label :email_address, "Email address", class: label_classes %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: input_classes %>
  </div>

  <div class="flex items-center justify-between gap-4">
    <%= form.submit "Email reset instructions", class: button_classes(:primary) %>
    <%= link_to "Back to sign in", new_session_path, class: "text-sm text-gray-600 underline hover:no-underline" %>
  </div>
<% end %>
