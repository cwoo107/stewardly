<% content_for :title, "Check in: #{@event.title}" %>
<%= render "shared/page_header", title: "Check in: #{@event.title}",
      subtitle: "#{l(@occurrence.starts_at, format: :long)} · #{@occurrence.checked_in_count} of #{@occurrence.seats_taken} here" do %>
  <%= link_to "All registrations", event_registrations_path(@event), class: button_classes(:outline) %>
<% end %>

<%= form_with url: event_occurrence_check_in_path(@event, @occurrence), method: :get, class: "mb-6 flex gap-3", data: { turbo_action: "replace" } do |form| %>
  <%= form.search_field :q, value: params[:q], placeholder: "Find a name", autofocus: true, class: input_classes, aria: { label: "Find a name" } %>
  <%= form.submit "Search", class: button_classes(:secondary) %>
<% end %>

<div class="overflow-hidden rounded-4xl bg-white shadow-sm ring-1 ring-gray-200">
  <ul role="list" class="divide-y divide-gray-100">
    <% @registrations.each do |registration| %>
      <%= render "event_check_ins/registration", registration:, event: @event %>
    <% end %>
    <% if @registrations.empty? %><li class="px-6 py-6 text-sm text-gray-500">No one found.</li><% end %>
  </ul>
</div>

<section class="mt-6 <%= card_classes %>">
  <h2 class="text-lg font-semibold">Walk-in</h2>
  <%= form_with url: event_registrations_path(@event), class: "mt-4 grid gap-3 sm:grid-cols-[1fr_1fr_1fr_6rem_auto]" do |form| %>
    <%= hidden_field_tag :occurrence_id, @occurrence.id %>
    <%= form.text_field :first_name, placeholder: "First name", required: true, class: input_classes, aria: { label: "First name" } %>
    <%= form.text_field :last_name, placeholder: "Last name", required: true, class: input_classes, aria: { label: "Last name" } %>
    <%= form.email_field :email, placeholder: "Email (optional)", class: input_classes, aria: { label: "Email" } %>
    <%= form.number_field :party_size, value: 1, min: 1, max: @event.max_party_size, class: input_classes, aria: { label: "Party size" } %>
    <%= form.submit "Check in", class: button_classes(:primary) %>
  <% end %>
  <p class="mt-2 text-xs text-gray-500">An existing email links to that person (their details aren't changed).</p>
</section>
