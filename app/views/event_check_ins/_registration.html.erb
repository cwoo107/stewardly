<li id="<%= dom_id(registration) %>" class="flex flex-wrap items-center justify-between gap-3 px-6 py-3">
  <div>
    <p class="font-medium"><%= registration.person.name %><%= " + #{registration.party_size - 1}" if registration.party_size > 1 %></p>
    <p class="text-xs text-gray-500"><%= registration.status.humanize %><%= " · checked in #{l(registration.checked_in_at, format: :short)}" if registration.checked_in? %></p>
  </div>
  <% if registration.confirmed? %>
    <% if registration.checked_in? %>
      <%= button_to "Undo", event_registration_path(event, registration), method: :patch, params: { change: "undo_check_in" }, class: button_classes(:outline), form: { data: { turbo_stream: true } } %>
    <% else %>
      <%= button_to "Check in", event_registration_path(event, registration), method: :patch, params: { change: "check_in" }, class: button_classes(:primary), form: { data: { turbo_stream: true } } %>
    <% end %>
  <% end %>
</li>
