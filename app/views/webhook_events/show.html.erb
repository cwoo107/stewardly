<% content_for :title, "Webhook" %>
<%= render "shared/page_header", title: "Webhook from #{Integration.label_for(@event.provider)}", subtitle: l(@event.created_at, format: :long) do %>
  <%= button_to "Replay", replay_webhook_event_path(@event), class: button_classes(:outline) %>
<% end %>
<%= render "shared/email_nav" %>

<div class="space-y-6">
  <p class="text-sm"><%= badge @event.status.humanize %> <%= "Processed #{l(@event.processed_at, format: :long)}" if @event.processed_at %> <%= @event.error %></p>
  <section>
    <h2 class="mb-2 text-sm font-semibold">Body</h2>
    <pre class="overflow-x-auto rounded-2xl bg-gray-900 p-4 text-xs text-gray-100"><%= (JSON.pretty_generate(@event.payload) rescue @event.raw_body) %></pre>
  </section>
  <section>
    <h2 class="mb-2 text-sm font-semibold">Headers</h2>
    <pre class="overflow-x-auto rounded-2xl bg-gray-100 p-4 text-xs"><%= JSON.pretty_generate(@event.headers.to_h) %></pre>
  </section>
</div>
