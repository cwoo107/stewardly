<% content_for :title, "Content calendar" %>
<%= render "shared/page_header", title: "Content calendar", subtitle: l(@month, format: "%B %Y") do %>
  <nav class="flex gap-2" aria-label="Month">
    <%= link_to "← #{l(@month.prev_month, format: "%b")}", social_calendar_path(month: @month.prev_month.strftime("%Y-%m")), class: button_classes(:outline) %>
    <%= link_to "#{l(@month.next_month, format: "%b")} →", social_calendar_path(month: @month.next_month.strftime("%Y-%m")), class: button_classes(:outline) %>
  </nav>
<% end %>
<%= render "shared/social_nav" %>

<% range = Calendar::Month.range_for(@month) %>
<div class="hidden overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-200 md:block">
  <div class="grid grid-cols-7 border-b border-gray-200 bg-gray-50 text-center text-xs font-semibold text-gray-600">
    <% Date::ABBR_DAYNAMES.each do |day| %><div class="py-2"><%= day %></div><% end %>
  </div>
  <div class="grid grid-cols-7">
    <% range.each do |date| %>
      <div class="min-h-32 space-y-1 border-b border-r border-gray-100 p-1.5 <%= "bg-gray-50/60 text-gray-400" unless date.month == @month.month %>">
        <p class="text-xs font-semibold <%= "inline-flex h-6 w-6 items-center justify-center rounded-full bg-cyan-500 text-white" if date == Current.church.today %>"><%= date.day %></p>
        <% Array(@posts_by_date[date]).each do |post| %>
          <%= link_to (post.editable? ? edit_social_post_path(post) : post), class: "block truncate rounded px-1.5 py-1 text-xs #{post.published? ? "bg-green-50 text-green-900" : "bg-violet-50 text-violet-900"}" do %>
            <%= (post.published_at || post.scheduled_at).in_time_zone(Current.church.zone).strftime("%-l:%M") %> <%= post.body.truncate(40) %>
          <% end %>
        <% end %>
        <% Array(@events_by_date[date]).each do |occurrence| %>
          <% if @promoted.include?(occurrence.event_id) %>
            <p class="truncate rounded px-1.5 py-1 text-xs text-gray-500">📅 <%= occurrence.title %></p>
          <% else %>
            <%= link_to new_social_post_path(event_id: occurrence.event_id), class: "block truncate rounded border border-dashed border-gray-300 px-1.5 py-1 text-xs text-gray-700 hover:bg-gray-50" do %>📅 <%= occurrence.title %> · Draft a promo<% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<ul role="list" class="space-y-3 md:hidden">
  <% range.select { |date| date.month == @month.month && (@posts_by_date[date] || @events_by_date[date]) }.each do |date| %>
    <li class="<%= card_classes %>">
      <p class="text-sm font-semibold"><%= l(date, format: :long) %></p>
      <% Array(@posts_by_date[date]).each do |post| %><%= link_to post.body.truncate(80), (post.editable? ? edit_social_post_path(post) : post), class: "mt-2 block text-sm underline" %><% end %>
      <% Array(@events_by_date[date]).each do |occurrence| %><p class="mt-2 text-sm text-gray-600">📅 <%= occurrence.title %><%= link_to " · Draft a promo", new_social_post_path(event_id: occurrence.event_id), class: "underline" unless @promoted.include?(occurrence.event_id) %></p><% end %>
    </li>
  <% end %>
</ul>
