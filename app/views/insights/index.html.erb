<% content_for :title, "Insights" %>
<%= render "shared/page_header", title: "Insights", subtitle: "Things that need attention, found every morning at 4am. They close themselves when the situation clears." %>

<%= form_with url: insights_path, method: :get, class: "mb-6 flex flex-wrap items-end gap-3" do %>
  <%= select_tag :status, options_for_select(%w[ open snoozed resolved dismissed ].map { |s| [ s.humanize, s ] }, @status), class: "w-40 #{select_classes}", aria: { label: "Status" } %>
  <%= select_tag :kind, options_for_select(@kinds.map { |kind| [ Insights::Sweep.label_for(kind), kind ] }, params[:kind]), include_blank: "Every kind", class: "w-64 #{select_classes}", aria: { label: "Kind" } %>
  <%= select_tag :severity, options_for_select(Insight.severities.keys.map { |s| [ s.humanize, s ] }, params[:severity]), include_blank: "Any severity", class: "w-40 #{select_classes}", aria: { label: "Severity" } %>
  <label class="flex items-center gap-2 text-sm"><%= check_box_tag :mine, "1", params[:mine].present?, class: "rounded border-gray-300" %> Only mine</label>
  <%= submit_tag "Filter", class: button_classes(:outline), name: nil %>
<% end %>

<ul role="list" class="space-y-3">
  <% @insights.each do |insight| %><%= render "insights/insight", insight: %><% end %>
</ul>
<% if @insights.empty? %><p class="<%= card_classes %> text-sm text-gray-500">Nothing here.</p><% end %>
<%= render "shared/pagination", pagy: @pagy %>
