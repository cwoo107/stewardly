<% content_for :title, "Theme" %>
<%= render "shared/page_header", title: "Theme", subtitle: "Colors, fonts, logo, and footer for every page." %>
<%= render "shared/website_nav" %>

<%= form_with url: website_theme_path, method: :patch, multipart: true, class: "space-y-8" do %>
  <% Site::Theme.all.partition { |theme| !theme.premium }.each_with_index do |themes, index| %>
    <fieldset class="grid gap-4 md:grid-cols-3">
      <legend class="mb-3 text-sm font-semibold text-gray-900"><%= index.zero? ? "Theme" : "Premium themes" %></legend>
      <% themes.each do |theme| %>
        <label class="<%= card_classes %> flex cursor-pointer items-start gap-3 has-checked:ring-2 has-checked:ring-cyan-500">
          <%= radio_button_tag "site[theme_key]", theme.key, @site.theme_key == theme.key, class: "mt-1" %>
          <span>
            <span class="flex items-center gap-1">
              <% theme.defaults.values_at("brand_color", "accent_color", "surface_color").each do |color| %><span class="h-4 w-4 rounded-full ring-1 ring-gray-200" style="background: <%= color %>"></span><% end %>
              <% if theme.premium %><span class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">Premium</span><% end %>
            </span>
            <span class="mt-2 block font-semibold"><%= theme.name %></span>
            <span class="block text-sm text-gray-600"><%= theme.description %></span>
          </span>
        </label>
      <% end %>
    </fieldset>
  <% end %>
  <label class="flex items-center gap-2 text-sm"><%= check_box_tag :reset_colors, "1", false, class: "rounded border-gray-300" %> Use the chosen theme's own colors and fonts (your logo, text, and links are kept)</label>
  <label class="flex items-center gap-2 text-sm"><%= check_box_tag :theme_home, "1", false, class: "rounded border-gray-300" %> Start the home page from the chosen premium theme's design (replaces the home page draft; the live page doesn't change until you publish)</label>
  <p class="text-sm text-gray-600">Some themes have settings of their own (like a header button or a motto). They appear below after you save the new theme.</p>

  <div class="grid gap-6 <%= card_classes %> md:grid-cols-2">
    <% current = @site.settings %>
    <% @site.theme.settings_schema.each do |setting| %>
      <%= render "email_template_sections/setting", setting:, name: "settings[#{setting["id"]}]", value: current[setting["id"]] %>
    <% end %>
  </div>
  <%= submit_tag "Save theme", class: button_classes(:primary) %>
<% end %>
