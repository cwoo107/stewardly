<div class="mb-3 flex items-center justify-between gap-3">
  <h2 class="text-sm font-semibold text-gray-900">Preview (draft)</h2>
  <div class="flex gap-1 rounded-lg bg-gray-100 p-1 text-sm" role="group" aria-label="Preview width">
    <%= link_to "Desktop", preview_website_page_path(page), data: { turbo_frame: "page_preview" }, class: "rounded-md px-3 py-1 hover:bg-white" %>
    <%= link_to "Mobile", preview_website_page_path(page, width: "mobile"), data: { turbo_frame: "page_preview" }, class: "rounded-md px-3 py-1 hover:bg-white" %>
  </div>
</div>
<%= turbo_frame_tag "page_preview", src: preview_website_page_path(page) do %>
  <p class="rounded-2xl bg-gray-100 p-8 text-center text-sm text-gray-500">Rendering preview…</p>
<% end %>
