<% content_for :title, "Settings" %>
<%= render "shared/page_header", title: "Settings", subtitle: "Your church lives at #{Current.church.host}." %>
<%= render "shared/settings_nav" %>

<%= form_with model: @church, url: church_settings_path, method: :patch, multipart: true, class: "space-y-6 #{card_classes}" do |form| %>
  <%= render "shared/form_errors", messages: @church.errors.full_messages %>

  <div>
    <%= form.label :logo, "Logo", class: label_classes %>
    <div class="flex flex-wrap items-center gap-4">
      <span class="flex h-16 w-16 items-center justify-center rounded-xl bg-gray-50 ring-1 ring-gray-200"><%= render "shared/logo", class: "h-12 w-12" %></span>
      <div class="space-y-2">
        <%= form.file_field :logo, accept: Church::LOGO_TYPES.join(","), class: "block text-sm" %>
        <% if @church.logo.attached? && @church.logo.persisted? %>
          <label class="flex items-center gap-2 text-sm text-gray-600"><%= check_box_tag "church[remove_logo]", "1", false, class: "rounded border-gray-300" %> Use the default logo instead</label>
        <% end %>
      </div>
    </div>
    <p class="mt-2 text-sm text-gray-500">PNG, JPEG, or WebP, under 2 MB. A square image works best. It replaces the default mark in the sidebar, the member area, sign-in pages, and on your website unless the website has its own logo.</p>
  </div>

  <div>
    <%= form.label :name, "Church name", class: label_classes %>
    <%= form.text_field :name, required: true, class: input_classes %>
  </div>

  <div>
    <%= form.label :time_zone, class: label_classes %>
    <%= form.time_zone_select :time_zone, ActiveSupport::TimeZone.us_zones, {}, class: select_classes %>
    <p class="mt-2 text-sm text-gray-500">Schedules, “this Sunday”, reminders, and reports all use this time zone.</p>
  </div>

  <div>
    <%= form.label :group_coverage_miles, "Group coverage radius (miles)", class: label_classes %>
    <%= form.number_field :group_coverage_miles, min: 1, max: 50, class: "#{input_classes}" %>
    <p class="mt-2 text-sm text-gray-500">Households farther than this from every active group show up as a coverage gap on the map.</p>
  </div>

  <div>
    <%= form.label :contact_email, "Contact email", class: label_classes %>
    <%= form.email_field :contact_email, class: input_classes %>
    <p class="mt-2 text-sm text-gray-500">Replies to church emails go here.</p>
  </div>

  <div>
    <%= form.label :giving_url, "Online giving link", class: label_classes %>
    <%= form.url_field :giving_url, placeholder: "https://tithe.ly/give?c=…", class: input_classes %>
    <p class="mt-2 text-sm text-gray-500">The member area's Give button opens this page.</p>
  </div>

  <div>
    <%= label_tag "church_attendance_categories_text", "Attendance categories", class: label_classes %>
    <%= text_area_tag "church[attendance_categories_text]", @church.attendance_categories.join("\n"), id: "church_attendance_categories_text", rows: 3, class: input_classes %>
    <p class="mt-2 text-sm text-gray-500">One per line. A category named “Online” counts as online; the rest are in person.</p>
  </div>

  <div>
    <%= form.label :reminder_days_before, "Remind volunteers (days before)", class: label_classes %>
    <%= form.number_field :reminder_days_before, min: 1, max: 14, class: "#{input_classes}" %>
  </div>

  <div>
    <%= form.label :no_contact_days, "Flag members with no contact after (days)", class: label_classes %>
    <%= form.number_field :no_contact_days, min: 14, max: 365, class: input_classes %>
    <p class="mt-2 text-sm text-gray-500">Used by the “No contact in a while” insight.</p>
  </div>

  <div>
    <%= form.label :workflow_daily_send_limit, "Workflow emails per day", class: label_classes %>
    <%= form.number_field :workflow_daily_send_limit, min: 0, max: 100_000, class: "#{input_classes}" %>
    <p class="mt-2 text-sm text-gray-500">A safety limit for automated email. Anything over it waits until 8am the next day.</p>
  </div>

  <label class="flex items-start gap-2 text-sm">
    <%= form.check_box :social_event_promos, class: "mt-0.5 rounded border-gray-300" %>
    <span>Draft a social post when a public event is published<span class="block text-gray-500">Drafts only: nothing is posted until someone schedules it.</span></span>
  </label>

  <fieldset class="space-y-4 rounded-2xl bg-gray-50 p-4">
    <legend class="text-sm font-semibold text-gray-900">Benevolence</legend>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= label_tag "church_benevolence_approval_threshold", "Extra approval above", class: label_classes %>
        <%= text_field_tag "church[benevolence_approval_threshold]", format("%.2f", @church.benevolence_approval_threshold_cents / 100.0),
              id: "church_benevolence_approval_threshold", inputmode: "decimal", class: input_classes %>
      </div>
      <div>
        <%= form.label :benevolence_approvals_required, "Approvals needed above that", class: label_classes %>
        <%= form.select :benevolence_approvals_required, [ [ "1 person", 1 ], [ "2 people", 2 ] ], {}, class: select_classes %>
      </div>
      <div>
        <%= label_tag "church_benevolence_annual_limit", "Limit per 12 months", class: label_classes %>
        <%= text_field_tag "church[benevolence_annual_limit]", format("%.2f", @church.benevolence_annual_limit_cents / 100.0),
              id: "church_benevolence_annual_limit", inputmode: "decimal", class: input_classes %>
      </div>
      <div>
        <%= form.label :benevolence_limit_scope, "Limit applies to each", class: label_classes %>
        <%= form.select :benevolence_limit_scope, [ [ "Household", "household" ], [ "Person", "person" ] ], {}, class: select_classes %>
      </div>
    </div>
    <p class="text-sm text-gray-500">Requests above the threshold need approval from people who aren't handling the case. The limit is a warning on the case, not a block. Use 0 for no limit.</p>
  </fieldset>

  <fieldset class="space-y-4 rounded-2xl bg-gray-50 p-4">
    <legend class="text-sm font-semibold text-gray-900">AI</legend>
    <label class="flex items-start gap-2 text-sm">
      <%= form.check_box :ai_enabled, class: "mt-0.5 rounded border-gray-300" %>
      <span>Let workflows draft messages with AI<span class="block text-gray-500">
        The AI runs on Stewardly's own server, not a third-party service. Drafts wait for approval unless a church admin
        turns on auto-send for a step. Prayer requests, notes, and contact details are never sent to it.</span></span>
    </label>
    <label class="flex items-start gap-2 text-sm">
      <%= form.check_box :ai_private_totals, class: "mt-0.5 rounded border-gray-300" %>
      <span>Include prayer and benevolence totals in reports<span class="block text-gray-500">Counts and dollar totals only, and only for people who already have those permissions. Request text is never included.</span></span>
    </label>
    <div>
      <%= form.label :ai_monthly_token_cap, "Monthly AI limit (tokens)", class: label_classes %>
      <%= form.number_field :ai_monthly_token_cap, min: 0, step: 1000, class: "#{input_classes}" %>
      <p class="mt-2 text-sm text-gray-500">
        Used this month: <%= number_with_delimiter(AiRequest.tokens_used_since(@church.now.beginning_of_month)) %>.
        A short drafted email is roughly 500 tokens.</p>
    </div>
  </fieldset>

  <%= form.submit "Save settings", class: button_classes(:primary) %>
<% end %>
