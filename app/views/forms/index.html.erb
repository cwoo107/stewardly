<% content_for :title, "Forms" %>
<%= render "shared/page_header", title: "Forms", subtitle: "Build forms anyone can fill in on your church's site." do %>
  <%= link_to "New form", new_form_path, class: button_classes(:primary) if policy(Form).create? %>
<% end %>

<div class="grid gap-6 sm:grid-cols-2">
  <% @forms.each do |form| %>
    <article class="<%= card_classes %>" id="<%= dom_id(form) %>">
      <div class="flex items-start justify-between gap-3">
        <h2 class="font-semibold"><%= link_to form.name, form, class: "hover:underline" %></h2>
        <%= badge(form.status.humanize, color: { "published" => "green", "draft" => "amber" }.fetch(form.status, "gray")) %>
      </div>
      <p class="mt-1 text-sm text-gray-600"><%= Form::PURPOSE_LABELS.fetch(form.purpose) %> · <%= pluralize(@submission_counts[form.id].to_i, "submission") %></p>
      <% if form.published? %><p class="mt-2 truncate text-sm text-cyan-700"><%= link_to public_form_url(form.slug), public_form_path(form.slug), target: "_blank", rel: "noopener" %></p><% end %>
      <div class="mt-4 flex flex-wrap gap-2">
        <%= link_to "Edit", edit_form_path(form), class: button_classes(:outline) if policy(form).update? %>
        <%= link_to "Submissions", form_submissions_path(form), class: button_classes(:outline) if policy(FormSubmission.new(form:)).index? %>
      </div>
    </article>
  <% end %>
</div>
<% if @forms.empty? %><p class="<%= card_classes %> text-sm text-gray-500">No forms yet.</p><% end %>
