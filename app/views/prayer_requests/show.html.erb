<% content_for :title, "Prayer request" %>
<%= render "shared/page_header", title: "Prayer for #{@prayer_request.requester_display_name}",
      subtitle: [ @prayer_request.status.humanize, @prayer_request.visibility.humanize, l(@prayer_request.created_at, format: :short) ].join(" · ") do %>
  <div class="flex flex-wrap gap-2">
    <% if policy(@prayer_request).update? %>
      <% unless @prayer_request.answered? %>
        <%= button_to "Mark answered", @prayer_request, method: :patch, params: { prayer_request: { status: "answered" } }, class: button_classes(:outline) %>
      <% end %>
      <%= link_to "Edit", edit_prayer_request_path(@prayer_request), class: button_classes(:outline) %>
    <% end %>
  </div>
<% end %>

<div class="grid gap-6 lg:grid-cols-3">
  <section class="<%= card_classes %> lg:col-span-2">
    <p class="whitespace-pre-line text-gray-800"><%= @prayer_request.body %></p>
    <% if @prayer_request.person %>
      <p class="mt-4 text-sm"><%= link_to "View #{@prayer_request.person.name}'s profile", @prayer_request.person, class: "text-cyan-700 hover:underline" if policy(@prayer_request.person).show? %></p>
    <% elsif @prayer_request.requester_email.present? %>
      <p class="mt-4 text-sm text-gray-600"><%= @prayer_request.requester_email %></p>
    <% end %>
    <% if @prayer_request.answer_note.present? %>
      <div class="mt-6 rounded-2xl bg-green-50 p-4 text-sm text-green-900">
        <p class="font-semibold">Answered<%= " #{l(@prayer_request.answered_at.to_date, format: :long)}" if @prayer_request.answered_at %></p>
        <p class="mt-1 whitespace-pre-line"><%= @prayer_request.answer_note %></p>
      </div>
    <% end %>

    <h2 class="mt-8 text-lg font-semibold">Follow-ups</h2>
    <% if policy(@prayer_request).follow_up? %>
      <%= form_with scope: :follow_up, url: prayer_request_follow_ups_path(@prayer_request), class: "mt-3 space-y-3" do |form| %>
        <%= form.text_area :body, rows: 2, placeholder: "How did the follow-up go?", class: input_classes, aria: { label: "Follow-up notes" } %>
        <%= form.submit "Log follow-up", class: button_classes(:primary) %>
      <% end %>
    <% elsif @prayer_request.person.nil? %>
      <p class="mt-2 text-sm text-gray-500">Link this request to a person to log follow-ups on their timeline.</p>
    <% end %>
    <ol role="list" class="mt-4 space-y-4">
      <% @prayer_request.follow_ups.includes(author: :person).each do |follow_up| %>
        <li class="border-l-2 border-cyan-100 pl-4 text-sm">
          <p class="whitespace-pre-line text-gray-700"><%= follow_up.body.presence || "Followed up" %></p>
          <p class="mt-1 text-xs text-gray-500"><%= l(follow_up.occurred_at, format: :short) %><%= " · #{follow_up.author.name}" if follow_up.author %></p>
        </li>
      <% end %>
    </ol>
  </section>

  <section class="<%= card_classes %>">
    <h2 class="text-lg font-semibold">Praying</h2>
    <ul role="list" class="mt-4 divide-y divide-gray-100">
      <% @prayer_request.prayer_assignments.each do |assignment| %>
        <li class="flex items-center justify-between py-2 text-sm">
          <%= assignment.user.name %>
          <%= button_to "Remove", prayer_request_prayer_assignment_path(@prayer_request, assignment), method: :delete, class: "text-gray-500 underline hover:no-underline" if policy(assignment).destroy? %>
        </li>
      <% end %>
      <% if @prayer_request.prayer_assignments.empty? %><li class="py-2 text-sm text-gray-500">No one assigned.</li><% end %>
    </ul>
    <% if (candidates = Array(@assignable_users) - @prayer_request.assignees).any? %>
      <%= form_with model: PrayerAssignment.new, url: prayer_request_prayer_assignments_path(@prayer_request), class: "mt-4 flex gap-2" do |form| %>
        <%= form.collection_select :user_id, candidates, :id, :name, {}, class: select_classes, aria: { label: "Prayer team member" } %>
        <%= form.submit "Assign", class: button_classes(:secondary) %>
      <% end %>
    <% end %>
  </section>
</div>
