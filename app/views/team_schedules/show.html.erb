<% content_for :title, "#{@team.name} schedule" %>
<% range = @board.range %>
<%= render "shared/page_header", title: "#{@team.name} schedule",
      subtitle: "#{l(range.first, format: :long)} – #{l(range.last, format: :long)} · #{pluralize(@board.open_slot_count, "open spot")}" do %>
  <div class="flex flex-wrap gap-2">
    <%= link_to "← Earlier", team_schedule_path(@team, from: range.first - 5.weeks), class: button_classes(:outline) %>
    <%= link_to "Later →", team_schedule_path(@team, from: range.last + 1), class: button_classes(:outline) %>
    <%= button_to "Auto-fill open spots", auto_fill_team_schedule_path(@team), params: { from: range.first }, class: button_classes(:secondary) %>
    <%= button_to "Send #{pluralize(@awaiting_request, "request")}", send_requests_team_schedule_path(@team), params: { from: range.first },
          class: button_classes(:primary), disabled: @awaiting_request.zero?, form: { data: { turbo_confirm: "Email #{pluralize(@awaiting_request, "volunteer")}?" } } %>
  </div>
<% end %>

<% if @board.occurrences.empty? %>
  <p class="<%= card_classes %> text-sm text-gray-600">
    Nothing to schedule in these weeks. Add <%= @team.name %> positions to a <%= link_to "worship service", worship_services_path, class: "underline" %> or an event's volunteer needs.
  </p>
<% else %>
  <div class="grid gap-6 xl:grid-cols-[16rem_1fr]" data-controller="schedule-board"
       data-schedule-board-create-url-value="<%= assignments_path %>">
    <aside class="<%= card_classes %> h-fit xl:sticky xl:top-6">
      <h2 class="text-sm font-semibold">Team</h2>
      <p class="mt-1 text-xs text-gray-500">Drag someone into a spot.</p>
      <ul class="mt-3 space-y-1" data-schedule-board-target="roster">
        <% @memberships.each do |membership| %>
          <li class="cursor-grab rounded-lg bg-gray-50 px-3 py-1.5 text-sm hover:bg-gray-100" data-person-id="<%= membership.person_id %>">
            <span class="flex items-center justify-between gap-2">
              <span><%= membership.person.name %><% if membership.max_per_month %><span class="text-xs text-gray-400"> · max <%= membership.max_per_month %>/mo</span><% end %></span>
              <% load = @board.roster_load_for(membership.person_id) %>
              <% unless load.level == "healthy" %><%= render "shared/load_badge", load: %><% end %>
            </span>
          </li>
        <% end %>
      </ul>
    </aside>

    <div class="overflow-x-auto rounded-4xl bg-white shadow-sm ring-1 ring-gray-200">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="sticky left-0 bg-gray-50 px-4 py-3 text-left font-semibold">Position</th>
            <% @board.occurrences.each do |occurrence| %>
              <th class="min-w-44 px-3 py-3 text-left align-bottom">
                <p class="font-semibold"><%= l(occurrence.local_date, format: :short) %></p>
                <p class="font-normal text-gray-500"><%= occurrence.title %></p>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @board.positions.each do |position| %>
            <tr>
              <th class="sticky left-0 bg-white px-4 py-3 text-left align-top font-medium"><%= position.name %></th>
              <% @board.occurrences.each do |occurrence| %>
                <td class="px-3 py-3 align-top"><%= render "assignments/cell", cell: @board.cell(occurrence, position), board: @board %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <p class="mt-4 text-sm text-gray-500">
    <%= badge("Pending", color: "amber") %> not answered · <%= badge("Accepted", color: "green") %> · <%= badge("Declined", color: "rose") %> ·
    <span class="text-rose-700">⚠</span> blocked out or serving elsewhere that day. Auto-fill never double-books a day, and nothing is emailed until you send requests.
  </p>
<% end %>
