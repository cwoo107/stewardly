<li class="rounded-2xl bg-white shadow-sm ring-1 ring-gray-200" data-move-url="<%= move_workflow_step_path(workflow, step["id"]) %>" id="step_<%= step["id"] %>">
  <div class="p-5">
    <%= turbo_frame_tag "step_frame_#{step["id"]}", src: (edit_workflow_step_path(workflow, step["id"]) if params[:editing] == step["id"]) do %>
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-wide text-gray-400"><span class="mr-1 cursor-grab text-gray-300" aria-hidden="true">⋮⋮</span><%= Workflow::Steps.label(step["type"]) %></p>
          <p class="mt-1 text-sm font-medium text-gray-900"><%= step_summary(step) %></p>
          <% problems = Workflow::Steps.for(step).errors %>
          <% if problems.any? %><p class="mt-1 text-xs text-amber-700">Needs attention: <%= problems.to_sentence %></p><% end %>
        </div>
        <span class="flex shrink-0 gap-3">
          <%= link_to "Edit", edit_workflow_step_path(workflow, step["id"]), class: "text-sm text-cyan-700 underline hover:no-underline" unless step["type"] == "update_pathway" %>
          <%= button_to "Remove", workflow_step_path(workflow, step["id"]), method: :delete, form: { data: { turbo_frame: "_top", turbo_confirm: step["type"] == "condition" ? "Remove this check and every step inside it?" : "Remove this step?" } },
                class: "text-sm text-gray-500 underline hover:no-underline cursor-pointer" %>
        </span>
      </div>
    <% end %>
  </div>

  <% if step["type"] == "condition" %>
    <div class="grid gap-4 border-t border-gray-100 p-4 md:grid-cols-2">
      <% Workflow::Definition::BRANCHES.each do |branch| %>
        <div class="space-y-3 rounded-xl bg-gray-50 p-3">
          <p class="text-xs font-semibold uppercase tracking-wide <%= branch == "yes" ? "text-green-700" : "text-rose-700" %>"><%= branch == "yes" ? "If yes" : "If no" %></p>
          <%= render "workflows/step_list", workflow:, steps: Array(step[branch]), parent_id: step["id"], branch: %>
        </div>
      <% end %>
    </div>
  <% end %>
</li>
