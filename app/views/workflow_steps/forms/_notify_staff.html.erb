<fieldset>
  <legend class="<%= label_classes %>">Email</legend>
  <div class="flex flex-wrap gap-x-4 gap-y-2">
    <% selected = Array(config["user_ids"]).map(&:to_i) %>
    <% staff_user_options.each do |name, id| %>
      <label class="inline-flex items-center gap-2 text-sm"><%= check_box_tag "config[user_ids][]", id, selected.include?(id), id: "config_user_#{id}", class: "rounded border-gray-300" %> <%= name %></label>
    <% end %>
  </div>
</fieldset>
<%= render "workflow_steps/forms/field", key: "message", label: "Message", hint: "{{ person.name }} works here. The email links to their profile." do %>
  <%= text_area_tag "config[message]", config["message"], id: "config_message", rows: 3, class: input_classes %>
<% end %>
