<% links = [ [ "Ask", report_conversations_path ], [ "Metrics", metrics_path ], [ "Saved reports", saved_reports_path ] ] %>
<nav class="mb-8 flex flex-wrap gap-2" aria-label="Reports">
  <% links.each do |label, path| %>
    <%= link_to label, path, class: "rounded-full px-3 py-1 text-sm #{request.path.start_with?(path) ? "bg-gray-900 text-white" : "bg-white text-gray-700 ring-1 ring-gray-200 hover:bg-gray-50"}" %>
  <% end %>
</nav>
