<% if messages.any? %>
  <div class="mb-6 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
    <p class="font-semibold">Please fix the following:</p>
    <ul class="mt-1 list-disc pl-5">
      <% messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
