<% links = [
     [ "Campaigns", campaigns_path, policy(Campaign).index? ],
     [ "Templates", email_templates_path, policy(EmailTemplate).index? ],
     [ "Topics", email_topics_path, policy(EmailTopic).index? ],
     [ "Suppressions", suppressions_path, policy(Suppression).index? ],
     [ "Settings", email_settings_path, policy(:email_settings).show? ],
     [ "Webhook log", webhook_events_path, policy(WebhookEvent).index? ]
   ].select(&:last) %>
<nav class="mb-8 flex flex-wrap gap-2" aria-label="Email">
  <% links.each do |label, path, _| %>
    <%= link_to label, path, class: "rounded-full px-3 py-1 text-sm #{request.path.start_with?(path) ? "bg-gray-900 text-white" : "bg-white text-gray-700 ring-1 ring-gray-200 hover:bg-gray-50"}" %>
  <% end %>
</nav>
