<%= form_with model: ministry, class: "space-y-6 #{card_classes}" do |form| %>
  <%= render "shared/form_errors", messages: ministry.errors.full_messages %>
  <%= render "shared/field", form:, attribute: :name, options: { required: true, placeholder: "Kids, Worship, Hospitality…" } %>
  <%= render "shared/field", form:, attribute: :description, type: :text_area, options: { rows: 3 } %>
  <div class="flex gap-3">
    <%= form.submit class: button_classes(:primary) %>
    <%= link_to "Cancel", ministry.persisted? ? ministry : ministries_path, class: button_classes(:outline) %>
  </div>
<% end %>
