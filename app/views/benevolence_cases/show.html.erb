<% content_for :title, @case.title %>
<%= render "shared/page_header", title: @case.title, subtitle: "Opened #{l(@case.created_at.to_date, format: :long)}#{" from the #{@case.form_submission.form.name} form" if @case.form_submission}" do %>
  <div class="flex flex-wrap items-center gap-2">
    <%= benevolence_status_badge(@case) %>
    <%= link_to "Edit", edit_benevolence_case_path(@case), class: button_classes(:outline) if policy(@case).update? %>
  </div>
<% end %>

<% if @flags.any? %>
  <div class="mb-6 flex flex-wrap gap-2"><% @flags.each do |flag| %><%= benevolence_flag_badge(flag) %><% end %></div>
<% end %>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <section class="<%= card_classes %>" aria-labelledby="details_heading">
      <h2 id="details_heading" class="font-semibold">Request</h2>
      <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-3">
        <div><dt class="text-gray-500">Requested</dt><dd class="text-lg font-semibold"><%= @case.requested %></dd></div>
        <div><dt class="text-gray-500">Approved</dt><dd class="text-lg font-semibold"><%= @case.approved_amount || "—" %></dd></div>
        <div><dt class="text-gray-500">Paid</dt><dd class="text-lg font-semibold"><%= Money.format(@case.disbursed_cents, @case.currency) %></dd></div>
      </dl>
      <p class="mt-4 font-medium"><%= @case.summary %></p>
      <% if @case.circumstances.present? %><p class="mt-2 whitespace-pre-line text-sm text-gray-700"><%= @case.circumstances %></p><% end %>
      <p class="mt-4 text-sm text-gray-600">
        <%= link_to @case.person.name, @case.person, class: "underline" %>
        <%= " · #{@case.household.name}" if @case.household %>
        · handled by <%= @case.assigned_to&.name || "no one yet" %>
      </p>
      <% if @case.decision_note.present? %><p class="mt-4 rounded-lg bg-gray-50 px-3 py-2 text-sm">Decision note: <%= @case.decision_note %></p><% end %>
    </section>

    <section class="<%= card_classes %>" id="payments" aria-labelledby="payments_heading">
      <h2 id="payments_heading" class="font-semibold">Payments</h2>
      <ul role="list" class="mt-4 divide-y divide-gray-100 text-sm">
        <% @case.disbursements.each do |payment| %>
          <li class="flex flex-wrap justify-between gap-2 py-2">
            <span><%= l(payment.paid_on, format: :long) %> · <%= BenevolenceDisbursement::METHODS.fetch(payment.method) %> to <%= payment.payee_name %>
              (<%= BenevolenceDisbursement::PAYEES.fetch(payment.payee_type).downcase %>)<%= " · #{payment.fund.name}" if payment.fund %><%= " · ref #{payment.reference}" if payment.reference.present? %></span>
            <span class="font-medium tabular-nums"><%= payment.amount %></span>
          </li>
        <% end %>
        <% if @case.disbursements.empty? %><li class="py-2 text-gray-500">No payments yet.</li><% end %>
      </ul>
      <% if @case.approved? && policy(@case).disburse? %>
        <%= form_with model: @disbursement, url: benevolence_case_disbursements_path(@case), class: "mt-6 grid gap-4 border-t border-gray-100 pt-6 sm:grid-cols-2" do |form| %>
          <h3 class="text-sm font-semibold sm:col-span-2">Record a payment (<%= Money.format(@case.remaining_cents, @case.currency) %> left)</h3>
          <div>
            <%= label_tag "benevolence_disbursement_amount", "Amount", class: label_classes %>
            <%= text_field_tag "benevolence_disbursement[amount]", @case.remaining_cents.positive? ? format("%.2f", @case.remaining_cents / 100.0) : nil,
                  id: "benevolence_disbursement_amount", inputmode: "decimal", class: input_classes %>
          </div>
          <%= render "shared/field", form:, attribute: :paid_on, label: "Paid on", type: :date_field %>
          <div><%= form.label :payee_type, "Paid to", class: label_classes %><%= form.select :payee_type, BenevolenceDisbursement::PAYEES.invert, {}, class: select_classes %></div>
          <%= render "shared/field", form:, attribute: :payee_name, label: "Payee name", options: { required: true, placeholder: "Springfield Apartments" } %>
          <div><%= form.label :method, "How", class: label_classes %><%= form.select :method, BenevolenceDisbursement::METHODS.invert, {}, class: select_classes %></div>
          <div><%= form.label :fund_id, "Fund", class: label_classes %><%= form.collection_select :fund_id, Fund.for_benevolence.alphabetical, :id, :name, { include_blank: "No fund" }, class: select_classes %></div>
          <%= render "shared/field", form:, attribute: :reference, label: "Reference (optional)", hint: "e.g. a check number. Encrypted.", wrapper_class: "sm:col-span-2" %>
          <div class="sm:col-span-2"><%= form.submit "Record payment", class: button_classes(:primary) %></div>
        <% end %>
      <% end %>
    </section>

    <section class="<%= card_classes %>" id="notes" aria-labelledby="notes_heading">
      <h2 id="notes_heading" class="font-semibold">Notes</h2>
      <ul role="list" class="mt-4 space-y-3 text-sm">
        <% @case.notes.includes(author: :person).each do |note| %>
          <li class="rounded-xl bg-gray-50 p-3"><p class="whitespace-pre-line"><%= note.body %></p><p class="mt-1 text-xs text-gray-500"><%= note.author&.name %> · <%= l(note.created_at, format: :short) %></p></li>
        <% end %>
        <% if @case.notes.empty? %><li class="text-gray-500">No notes yet.</li><% end %>
      </ul>
      <% if policy(@case).note? %>
        <%= form_with model: BenevolenceNote.new, url: benevolence_case_notes_path(@case), class: "mt-4 space-y-3" do |form| %>
          <%= form.label :body, "Add a note", class: label_classes %>
          <%= form.text_area :body, rows: 3, class: input_classes %>
          <%= form.submit "Add note", class: button_classes(:outline) %>
        <% end %>
      <% end %>
    </section>
  </div>

  <div class="space-y-6">
    <section class="<%= card_classes %>" aria-labelledby="decision_heading">
      <h2 id="decision_heading" class="font-semibold">Decision</h2>
      <p class="mt-2 text-sm text-gray-600">
        <% if @decision.above_threshold? %>
          Above <%= Money.format(Current.church.benevolence_approval_threshold_cents) %>, so it needs <%= pluralize(@decision.approvals_required, "approval") %> from someone not handling the case.
        <% else %>
          One approval decides it.
        <% end %>
      </p>
      <ul role="list" class="mt-4 space-y-2 text-sm">
        <% @case.approvals.includes(user: :person).each do |approval| %>
          <li><%= badge(approval.approve? ? "Approved" : "Denied", color: approval.approve? ? "green" : "rose") %> <%= approval.user.name %>
            <%= Money.format(approval.amount_cents) if approval.amount_cents %><% if approval.note.present? %><span class="block text-gray-600"><%= approval.note %></span><% end %></li>
        <% end %>
      </ul>
      <% if (@case.submitted? || @case.under_review?) && policy(@case).decide? %>
        <% if (reason = @decision.ineligibility(Current.user)) %>
          <p class="mt-4 text-sm text-gray-500"><%= reason %>.</p>
        <% else %>
          <%= form_with url: decide_benevolence_case_path(@case), class: "mt-4 space-y-3" do %>
            <div>
              <%= label_tag :amount, "Amount to approve", class: label_classes %>
              <%= text_field_tag :amount, format("%.2f", @case.requested_cents / 100.0), inputmode: "decimal", class: input_classes %>
            </div>
            <div>
              <%= label_tag :note, "Note (optional)", class: label_classes %>
              <%= text_area_tag :note, nil, rows: 2, class: input_classes %>
            </div>
            <div class="flex flex-wrap gap-2">
              <%= button_tag "Approve", name: "decision", value: "approve", class: button_classes(:primary) %>
              <%= button_tag "Deny", name: "decision", value: "deny", class: button_classes(:danger), data: { turbo_confirm: "Deny this request?" } %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </section>

    <section class="<%= card_classes %>" aria-labelledby="history_heading">
      <h2 id="history_heading" class="font-semibold">History</h2>
      <p class="mt-1 text-sm text-gray-600"><%= Money.format(@history.paid_cents) %> paid to this person and household, all time.</p>
      <ul role="list" class="mt-4 space-y-2 text-sm">
        <% @history.cases.each do |kase| %>
          <li><%= link_to kase.title, kase, class: "hover:underline" %><span class="block text-xs text-gray-500"><%= l(kase.created_at.to_date, format: :long) %> · <%= kase.status.humanize %> · <%= kase.approved_amount || kase.requested %></span></li>
        <% end %>
        <% if @history.cases.empty? %><li class="text-gray-500">No earlier requests.</li><% end %>
      </ul>
    </section>
  </div>
</div>
