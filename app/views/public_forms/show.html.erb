<% content_for :title, @form.name %>
<% preview = @preview %>
<% if preview %>
  <p class="mb-6 rounded-lg bg-amber-50 px-4 py-3 text-sm font-medium text-amber-800">
    Preview. Submitting is turned off. <%= link_to "Back to the builder", edit_form_path(@form), class: "underline" %>
  </p>
<% end %>

<h1 class="text-3xl font-medium tracking-tight"><%= @form.name %></h1>
<% if @form.description.present? %><p class="mt-2 whitespace-pre-line text-gray-600"><%= @form.description %></p><% end %>

<% if @form.closed? %>
  <p class="mt-8 <%= card_classes %> text-gray-700">This form is closed and no longer accepting responses.</p>
<% else %>
  <%= form_with url: preview ? "#" : public_form_path(@form.slug), multipart: true, class: "mt-8 space-y-6 #{card_classes}",
        data: { controller: "form-logic", form_logic_rules_value: @form.visibility_rules.to_json,
                action: "input->form-logic#update change->form-logic#update" } do |form| %>
    <% if @response&.errors&.any? %>
      <p class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">Please check the highlighted answers.</p>
    <% end %>

    <% @form.fields.each do |field| %>
      <%= render "public_forms/field", field:, value: @response&.value_for(field.key), error: @response&.errors&.dig(field.key) %>
    <% end %>

    <%# Honeypot and fill-time check (see PublicFormsController). %>
    <div class="hidden" aria-hidden="true">
      <label>Leave this empty <input type="text" name="<%= PublicSubmissionProtection::HONEYPOT %>" tabindex="-1" autocomplete="off"></label>
    </div>
    <%= hidden_field_tag :started_at, PublicSubmissionProtection.started_at_token, id: nil %>

    <%= form.submit "Submit", class: "w-full sm:w-auto #{button_classes(:primary)}", disabled: preview %>
  <% end %>
<% end %>
