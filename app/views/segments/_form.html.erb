<%= form_with model: segment, class: "space-y-6",
      data: { controller: "segment-builder", action: "change->segment-builder#refresh input->segment-builder#refresh",
              segment_builder_condition_url_value: condition_segments_path, segment_builder_preview_url_value: preview_segments_path } do |form| %>
  <%= render "shared/form_errors", messages: segment.errors.full_messages %>

  <div class="<%= card_classes %> space-y-6">
    <div class="grid gap-6 sm:grid-cols-2">
      <%= render "shared/field", form:, attribute: :name, options: { required: true } %>
      <%= render "shared/field", form:, attribute: :description %>
    </div>

    <div>
      <label for="segment_match" class="<%= label_classes %>">Include people who match</label>
      <%= select_tag "segment[definition][match]", options_for_select([ [ "All of these conditions", "all" ], [ "Any of these conditions", "any" ] ], segment.match),
            id: "segment_match", class: "max-w-xs #{select_classes}" %>
    </div>

    <div id="segment_conditions" class="space-y-4">
      <% segment.conditions.each_with_index do |condition, index| %>
        <%= render "segments/condition", condition:, index: %>
      <% end %>
    </div>

    <div class="flex flex-wrap items-end gap-3 border-t border-gray-100 pt-6">
      <div>
        <label for="new_condition_type" class="<%= label_classes %>">Add a condition</label>
        <%= select_tag :new_condition_type, options_for_select(Segment::Condition::TYPES.invert), id: "new_condition_type",
              class: select_classes, data: { segment_builder_target: "type" }, form: "none" %>
      </div>
      <button type="button" class="<%= button_classes(:secondary) %>" data-action="segment-builder#add">Add</button>
    </div>
  </div>

  <div class="<%= card_classes %>">
    <%= turbo_frame_tag "segment_preview", data: { segment_builder_target: "preview" } do %>
      <p class="text-sm text-gray-500">Counting…</p>
    <% end %>
  </div>

  <div class="flex gap-3">
    <%= form.submit "Save segment", class: button_classes(:primary) %>
    <%= link_to "Cancel", segment.persisted? ? segment : segments_path, class: button_classes(:outline) %>
  </div>
<% end %>
