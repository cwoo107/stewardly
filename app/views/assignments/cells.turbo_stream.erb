<% @cells.each do |cell| %>
  <%= turbo_stream.replace cell.dom_id, partial: "assignments/cell", locals: { cell:, board: @board } %>
<% end %>
<% if @assignment.errors.any? %>
  <%= turbo_stream.append "flash", html: tag.p(@assignment.errors.full_messages.to_sentence, class: "mb-6 rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-700") %>
<% end %>
