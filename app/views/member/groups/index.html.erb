<% content_for :title, "Groups" %>
<h1 class="text-2xl font-medium tracking-tight">Groups</h1>

<section class="mt-6">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">My groups</h2>
  <ul class="mt-3 space-y-3">
    <% @memberships.each do |membership| %>
      <li class="<%= card_classes %>">
        <p class="font-semibold"><%= membership.group.name %> <%= badge("Leader", color: "cyan") if membership.leader? %></p>
        <p class="mt-1 text-sm text-gray-600"><%= membership.group.meeting_summary %></p>
      </li>
    <% end %>
    <% if @memberships.empty? %><li class="<%= card_classes %> text-sm text-gray-500">You're not in a group yet.</li><% end %>
  </ul>
</section>

<section class="mt-8">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500"><%= person.household&.location ? "Groups near you" : "Find a group" %></h2>
  <ul class="mt-3 space-y-3">
    <% @nearest.each do |group| %>
      <li>
        <%= link_to member_group_path(group), class: "flex items-center justify-between gap-3 #{card_classes} hover:ring-cyan-500" do %>
          <div>
            <p class="font-semibold"><%= group.name %></p>
            <p class="mt-1 text-sm text-gray-600"><%= [ group.group_type.humanize, group.meeting_summary ].join(" · ") %></p>
          </div>
          <span class="shrink-0 text-sm text-gray-500">
            <% if @pending_group_ids.include?(group.id) %><%= badge("Requested", color: "amber") %><% elsif group.distance_miles %><%= number_with_precision(group.distance_miles, precision: 1) %> mi<% end %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
