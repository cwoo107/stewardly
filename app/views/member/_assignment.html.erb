<li class="<%= card_classes %>" id="<%= dom_id(assignment) %>">
  <p class="text-sm text-gray-500"><%= l(assignment.starts_at, format: :long) %></p>
  <p class="mt-1 font-semibold"><%= assignment.position.name %> · <%= assignment.team.name %></p>
  <p class="text-sm text-gray-600"><%= assignment.title %></p>
  <% if assignment.pending? %>
    <div class="mt-4 flex gap-2">
      <%= button_to "I'll serve", member_assignment_path(assignment), method: :patch, params: { answer: "accept" }, class: button_classes(:primary) %>
      <%= button_to "Can't make it", member_assignment_path(assignment), method: :patch, params: { answer: "decline" }, class: button_classes(:outline) %>
    </div>
  <% else %>
    <div class="mt-3 flex items-center gap-3">
      <%= badge("You're serving", color: "green") %>
      <%= button_to "Can't make it after all", member_assignment_path(assignment), method: :patch, params: { answer: "decline" },
            class: "text-sm text-gray-500 underline hover:no-underline", form: { data: { turbo_confirm: "Let the team know you can't serve?" } } %>
    </div>
  <% end %>
</li>
