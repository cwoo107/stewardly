<% content_for :title, "Classes" %>
<h1 class="text-2xl font-medium tracking-tight">Classes</h1>

<% if @enrollments.any? %>
  <section class="mt-6">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">My classes</h2>
    <ul class="mt-3 space-y-3">
      <% @enrollments.each do |enrollment| %>
        <% offering = enrollment.course_offering %>
        <li class="<%= card_classes %>">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="font-semibold"><%= offering.name %></p>
            <%= badge(enrollment.status.humanize, color: { "enrolled" => "cyan", "completed" => "green", "waitlisted" => "amber" }.fetch(enrollment.status, "gray")) %>
          </div>
          <p class="mt-1 text-sm text-gray-600">Starts <%= l(offering.starts_on, format: :long) %><%= " · #{offering.location_name}" if offering.location_name.present? %></p>
          <% if (next_session = offering.sessions.find { |s| s.starts_at.future? }) %>
            <p class="mt-1 text-sm text-gray-600">Next: <%= l(next_session.starts_at, format: :long) %></p>
          <% end %>
          <% if enrollment.enrolled? || enrollment.waitlisted? %>
            <%= button_to "Withdraw", member_enrollment_path(enrollment), method: :delete, class: "mt-3 text-sm text-gray-500 underline hover:no-underline",
                  form: { data: { turbo_confirm: "Withdraw from #{offering.name}?" } } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<section class="mt-8">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">Open for enrollment</h2>
  <ul class="mt-3 space-y-3">
    <% @offerings.each do |offering| %>
      <li class="<%= card_classes %>">
        <p class="font-semibold"><%= offering.name %></p>
        <p class="mt-1 text-sm text-gray-600">
          Starts <%= l(offering.starts_on, format: :long) %> · <%= pluralize(offering.sessions.size, "session") %><%= " · led by #{offering.leader.name}" if offering.leader %>
        </p>
        <% if offering.course.description.present? %><p class="mt-2 text-sm text-gray-700"><%= truncate(offering.course.description, length: 200) %></p><% end %>
        <%= button_to offering.full? ? "Join the waitlist" : "Enroll", member_enrollments_path, params: { course_offering_id: offering.id }, class: "mt-4 #{button_classes(:primary)}" %>
      </li>
    <% end %>
    <% if @offerings.empty? %><li class="<%= card_classes %> text-sm text-gray-500">No classes are open right now.</li><% end %>
  </ul>
</section>
