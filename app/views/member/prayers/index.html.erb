<% content_for :title, "Prayer" %>
<h1 class="text-2xl font-medium tracking-tight">Prayer</h1>
<% if @prayer_form %>
  <%= link_to "Share a prayer request", public_form_path(@prayer_form.slug), class: "mt-6 block #{card_classes} text-center font-semibold text-cyan-700 hover:ring-cyan-500" %>
<% end %>
<section class="mt-8">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">Pray with us</h2>
  <ul class="mt-3 space-y-3">
    <% @requests.each do |request| %>
      <li class="<%= card_classes %>">
        <p class="whitespace-pre-line text-gray-800"><%= request.body %></p>
        <p class="mt-2 text-xs text-gray-500"><%= request.person&.first_name || "Someone in our church" %> · <%= l(request.created_at.to_date, format: :long) %></p>
      </li>
    <% end %>
    <% if @requests.empty? %><li class="<%= card_classes %> text-sm text-gray-500">No shared requests right now.</li><% end %>
  </ul>
</section>
