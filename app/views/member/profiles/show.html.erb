<% content_for :title, "Profile" %>
<div class="flex items-center justify-between gap-3">
  <h1 class="text-2xl font-medium tracking-tight"><%= person.full_name %></h1>
  <%= link_to "Edit", edit_member_profile_path, class: button_classes(:outline) %>
</div>
<section class="mt-6 <%= card_classes %>">
  <dl class="space-y-3 text-sm">
    <div><dt class="text-gray-500">Email (sign-in)</dt><dd><%= Current.user.email_address %></dd></div>
    <div><dt class="text-gray-500">Phone</dt><dd><%= person.phone.presence || "—" %></dd></div>
    <div><dt class="text-gray-500">Birthday</dt><dd><%= person.birthdate ? l(person.birthdate, format: :long) : "—" %></dd></div>
    <div><dt class="text-gray-500">Home</dt><dd><%= @household&.full_address.presence || "—" %></dd></div>
  </dl>
</section>
<section class="mt-6 <%= card_classes %>">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold">My household</h2>
    <%= link_to "Add someone", new_member_household_member_path, class: "text-sm text-cyan-700 hover:underline" if @household %>
  </div>
  <ul role="list" class="mt-3 divide-y divide-gray-100">
    <% Array(@household&.people&.alphabetical).each do |member| %>
      <li class="flex items-center justify-between py-2 text-sm">
        <span><%= member.name %> <span class="text-gray-500">· <%= member.household_role.humanize %></span></span>
        <%= link_to "Edit", edit_member_household_member_path(member), class: "text-cyan-700 hover:underline" unless member == person %>
      </li>
    <% end %>
  </ul>
  <% unless @household %><p class="mt-2 text-sm text-gray-500">Add your home address to set up your household.</p><% end %>
</section>
