<% content_for :title, "Edit profile" %>
<h1 class="text-2xl font-medium tracking-tight">Edit profile</h1>
<%= form_with model: person, url: member_profile_path, method: :patch, class: "mt-6 space-y-6 #{card_classes}" do |form| %>
  <%= render "shared/form_errors", messages: person.errors.full_messages + @household.errors.full_messages %>
  <div class="grid gap-6 sm:grid-cols-2">
    <%= render "shared/field", form:, attribute: :first_name, options: { required: true } %>
    <%= render "shared/field", form:, attribute: :last_name, options: { required: true } %>
  </div>
  <div class="grid gap-6 sm:grid-cols-3">
    <%= render "shared/field", form:, attribute: :nickname, hint: "What people call you" %>
    <%= render "shared/field", form:, attribute: :phone, type: :telephone_field %>
    <%= render "shared/field", form:, attribute: :birthdate, label: "Birthday", type: :date_field %>
  </div>
  <fieldset class="space-y-4 border-t border-gray-100 pt-6">
    <legend class="text-sm font-semibold">Home address</legend>
    <%= fields_for :household, @household do |household| %>
      <%= render "shared/field", form: household, attribute: :address_line1, label: "Street" %>
      <%= render "shared/field", form: household, attribute: :address_line2, label: "Apartment, unit" %>
      <div class="grid grid-cols-6 gap-4">
        <%= render "shared/field", form: household, attribute: :city, wrapper_class: "col-span-3" %>
        <%= render "shared/field", form: household, attribute: :region, label: "State", wrapper_class: "col-span-1" %>
        <%= render "shared/field", form: household, attribute: :postal_code, label: "ZIP", wrapper_class: "col-span-2" %>
      </div>
    <% end %>
  </fieldset>
  <p class="text-sm text-gray-500">To change the email you sign in with, contact the church office.</p>
  <div class="flex gap-3">
    <%= form.submit "Save", class: button_classes(:primary) %>
    <%= link_to "Cancel", member_profile_path, class: button_classes(:outline) %>
  </div>
<% end %>
