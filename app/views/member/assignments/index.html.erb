<% content_for :title, "My schedule" %>
<h1 class="text-2xl font-medium tracking-tight">My schedule</h1>
<ul class="mt-6 space-y-3">
  <% @assignments.each do |assignment| %><%= render "member/assignment", assignment: %><% end %>
  <% if @assignments.empty? %><li class="<%= card_classes %> text-sm text-gray-500">You're not scheduled to serve.</li><% end %>
</ul>

<section class="mt-10 <%= card_classes %>">
  <h2 class="text-lg font-semibold">Days I can't serve</h2>
  <ul role="list" class="mt-3 divide-y divide-gray-100">
    <% @blockouts.each do |blockout| %>
      <li class="flex items-center justify-between py-2 text-sm">
        <span><%= l(blockout.starts_on, format: :long) %><%= " – #{l(blockout.ends_on, format: :long)}" if blockout.ends_on != blockout.starts_on %><%= " · #{blockout.reason}" if blockout.reason.present? %></span>
        <%= button_to "Remove", member_blockout_path(blockout), method: :delete, class: "text-gray-500 underline hover:no-underline" %>
      </li>
    <% end %>
    <% if @blockouts.empty? %><li class="py-2 text-sm text-gray-500">None.</li><% end %>
  </ul>
  <%= form_with model: @blockout, url: member_blockouts_path, class: "mt-4 grid gap-3 sm:grid-cols-[1fr_1fr_1fr_auto]" do |form| %>
    <%= form.date_field :starts_on, required: true, class: input_classes, aria: { label: "From" } %>
    <%= form.date_field :ends_on, class: input_classes, aria: { label: "Until (optional)" } %>
    <%= form.text_field :reason, placeholder: "Reason (optional)", class: input_classes, aria: { label: "Reason" } %>
    <%= form.submit "Add", class: button_classes(:secondary) %>
  <% end %>
</section>
