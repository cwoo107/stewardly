<% content_for :title, "Calendar" %>
<div class="flex items-center justify-between gap-3">
  <h1 class="text-2xl font-medium tracking-tight"><%= @month.strftime("%B %Y") %></h1>
  <div class="flex gap-2">
    <%= link_to "←", member_calendar_path(month: @month.prev_month.strftime("%Y-%m")), class: button_classes(:outline), aria: { label: "Previous month" } if @month > Current.church.today.beginning_of_month %>
    <%= link_to "→", member_calendar_path(month: @month.next_month.strftime("%Y-%m")), class: button_classes(:outline), aria: { label: "Next month" } %>
  </div>
</div>
<div class="mt-6 space-y-3">
  <% @feed.by_date.sort.each do |date, items| %>
    <section class="<%= card_classes %>">
      <h2 class="text-sm font-semibold"><%= l(date, format: :long) %></h2>
      <ul class="mt-2 space-y-1"><% items.each do |item| %><li><%= render "shared/calendar_item", item: %></li><% end %></ul>
    </section>
  <% end %>
  <% if @feed.items.empty? %><p class="<%= card_classes %> text-sm text-gray-500">Nothing on the calendar.</p><% end %>
</div>
