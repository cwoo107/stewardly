<% content_for :title, @task.title %>
<%= render "shared/page_header", title: @task.title, subtitle: [ @task.status.humanize, "#{@task.priority.humanize} priority" ].join(" · ") do %>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Edit", edit_task_path(@task), class: button_classes(:outline) if policy(@task).update? %>
    <% if policy(@task).destroy? %>
      <%= button_to "Delete", @task, method: :delete, class: button_classes(:danger), form: { data: { turbo_confirm: "Delete this task?" } } %>
    <% end %>
  </div>
<% end %>

<section class="<%= card_classes %> max-w-2xl">
  <dl class="grid gap-4 text-sm sm:grid-cols-3">
    <div><dt class="text-gray-500">Owner</dt><dd><%= @task.owner&.name || "Unassigned" %></dd></div>
    <div><dt class="text-gray-500">Due</dt><dd><%= @task.due_on ? l(@task.due_on, format: :long) : "—" %></dd></div>
    <div><dt class="text-gray-500">Project</dt><dd><%= @task.project&.name || "—" %></dd></div>
  </dl>
  <% if @task.notes.present? %><p class="mt-6 whitespace-pre-line text-sm text-gray-700"><%= @task.notes %></p><% end %>
  <% if @task.completed_at %><p class="mt-6 text-xs text-gray-500">Completed <%= l(@task.completed_at, format: :short) %></p><% end %>
</section>
<p class="mt-6"><%= link_to "← Back to tasks", tasks_path, class: "text-sm text-gray-600 hover:underline" %></p>
