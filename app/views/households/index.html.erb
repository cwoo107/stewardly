<% content_for :title, "Households" %>
<%= render "shared/page_header", title: "Households" do %>
  <%= link_to "Add household", new_household_path, class: button_classes(:primary) if policy(Household).create? %>
<% end %>

<%= form_with url: households_path, method: :get, class: "mb-6 flex gap-3", data: { turbo_action: "replace" } do |form| %>
  <%= form.search_field :q, value: params[:q], placeholder: "Search name or address", class: input_classes, aria: { label: "Search" } %>
  <%= form.submit "Search", class: button_classes(:secondary) %>
<% end %>

<div class="overflow-hidden rounded-4xl bg-white shadow-sm ring-1 ring-gray-200">
  <ul role="list" class="divide-y divide-gray-100">
    <% @households.each do |household| %>
      <li>
        <%= link_to household, class: "flex flex-wrap items-center justify-between gap-2 px-6 py-4 hover:bg-gray-50" do %>
          <div>
            <p class="font-medium"><%= household.name %></p>
            <p class="text-sm text-gray-500"><%= household.full_address.presence || "No address" %></p>
          </div>
          <p class="text-sm text-gray-500"><%= pluralize(household.people.size, "person") %></p>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
<%= render "shared/pagination", pagy: @pagy %>
