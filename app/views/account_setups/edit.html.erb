<% content_for :title, "Welcome, #{@person.first_name}" %>
<% content_for :subtitle, "Choose a password for #{@person.email}." %>
<%= form_with url: account_setup_path(token: params[:token]), method: :patch, class: "space-y-6" do |form| %>
  <div>
    <%= form.label :password, class: label_classes %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: input_classes %>
  </div>
  <div>
    <%= form.label :password_confirmation, "Repeat password", class: label_classes %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: input_classes %>
  </div>
  <%= form.submit "Create my account", class: button_classes(:primary) %>
<% end %>
