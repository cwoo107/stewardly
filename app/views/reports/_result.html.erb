<%# One tool call's numbers. Locals: call ({ "name", "title", "arguments", "result" | "error" }) %>
<div class="rounded-2xl bg-gray-50 p-4 ring-1 ring-gray-200">
  <p class="text-sm font-semibold"><%= call["title"] || call["name"].humanize %>
    <% if call["arguments"].present? %><span class="font-normal text-gray-500">· <%= call["arguments"].compact_blank.map { |k, v| "#{k.humanize.downcase}: #{v}" }.join(", ") %></span><% end %></p>
  <% if call["error"] %>
    <p class="mt-2 text-sm text-rose-700"><%= call["error"] %></p>
  <% else %>
    <% result = call["result"] %>
    <dl class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <% result["figures"].to_h.each do |label, value| %>
        <div class="rounded-xl bg-white p-3 ring-1 ring-gray-100"><dt class="text-xs text-gray-500"><%= label %></dt><dd class="text-lg font-semibold tabular-nums"><%= value.is_a?(Numeric) ? number_with_delimiter(value) : value %></dd></div>
      <% end %>
    </dl>
    <% Array(result["tables"]).each do |table| %>
      <div class="mt-3 overflow-x-auto">
        <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500"><%= table["title"] %></p>
        <table class="min-w-full text-left text-sm">
          <thead><tr class="text-gray-500"><% table["columns"].each do |column| %><th scope="col" class="py-1 pr-4 font-medium"><%= column %></th><% end %></tr></thead>
          <tbody><% table["rows"].each do |row| %><tr class="border-t border-gray-200"><% row.each do |cell| %><td class="py-1 pr-4 tabular-nums"><%= cell.is_a?(Numeric) ? number_with_delimiter(cell) : (cell.nil? ? "—" : cell) %></td><% end %></tr><% end %></tbody>
        </table>
        <% if table["rows"].empty? %><p class="text-sm text-gray-500">No rows.</p><% end %>
      </div>
    <% end %>
    <% if result["note"] %><p class="mt-2 text-xs text-gray-500"><%= result["note"] %></p><% end %>
  <% end %>
</div>
