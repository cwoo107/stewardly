<!doctype html>
<html lang="en">
<head>
  {{ head }}
</head>
<body class="site site-clarity">
  <header class="site-header relative z-40">
    <div class="flex items-center justify-between gap-8 px-6 py-6 sm:px-12 lg:px-24">
      <div class="flex items-center gap-12">
        <a href="/" class="flex items-center gap-3 text-base font-semibold tracking-tight">
          {% if site.logo_url != blank %}<img src="{{ site.logo_url }}" alt="{{ site.name | escape }}" style="width: {{ site.logo_width }}px">{% else %}<span class="clarity-mark" aria-hidden="true"></span>{{ site.name | escape }}{% endif %}
        </a>
        <nav aria-label="Main" class="hidden lg:block">
          <ul class="flex items-center gap-2 text-sm">
            {% for link in site.nav %}<li><a href="{{ link.url }}" class="site-nav-link{% if link.current %} is-current{% endif %}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>{% endfor %}
          </ul>
        </nav>
      </div>
      <div class="flex items-center gap-4">
        {% if theme.secondary_button_label != blank and theme.secondary_button_url != blank %}
          <a href="{{ theme.secondary_button_url | escape }}" class="clarity-button-outline hidden sm:inline-flex">{{ theme.secondary_button_label | escape }}</a>
        {% endif %}
        {% if theme.header_button_label != blank and theme.header_button_url != blank %}
          <a href="{{ theme.header_button_url | escape }}" class="site-button hidden px-3 py-2 text-sm font-semibold sm:inline-flex">{{ theme.header_button_label | escape }}</a>
        {% endif %}
        <details class="clarity-menu lg:hidden">
          <summary aria-label="Menu" class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg">
            <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" aria-hidden="true"><path d="M5 7h14M5 12h14M5 17h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </summary>
          <div class="clarity-menu-panel absolute inset-x-4 top-full rounded-2xl p-6">
            <ul class="space-y-1">
              {% for link in site.nav %}<li><a href="{{ link.url }}" class="site-nav-link block{% if link.current %} is-current{% endif %}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>{% endfor %}
            </ul>
            <div class="mt-6 flex flex-col gap-3">
              {% if theme.secondary_button_label != blank and theme.secondary_button_url != blank %}<a href="{{ theme.secondary_button_url | escape }}" class="clarity-button-outline justify-center">{{ theme.secondary_button_label | escape }}</a>{% endif %}
              {% if theme.header_button_label != blank and theme.header_button_url != blank %}<a href="{{ theme.header_button_url | escape }}" class="site-button inline-flex justify-center px-3 py-2 text-sm font-semibold">{{ theme.header_button_label | escape }}</a>{% endif %}
            </div>
          </div>
        </details>
      </div>
    </div>
  </header>
  <main>{{ content_for_layout }}</main>
  <footer class="site-footer px-6 sm:px-12 lg:px-24">
    <div class="flex flex-col justify-between gap-12 py-16 lg:flex-row lg:items-start">
      <div>
        <p class="flex items-center gap-3 text-base font-semibold tracking-tight">{% if site.logo_url == blank %}<span class="clarity-mark" aria-hidden="true"></span>{% endif %}{{ site.name | escape }}</p>
        {% if site.tagline != blank %}<p class="mt-2 text-sm text-(--site-muted)">{{ site.tagline | escape }}</p>{% endif %}
        <nav aria-label="Footer" class="mt-10">
          <ul class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
            {% for link in site.nav %}<li><a href="{{ link.url }}" class="text-(--site-muted) hover:text-(--site-text)">{{ link.title | escape }}</a></li>{% endfor %}
          </ul>
        </nav>
      </div>
      {% if site.footer_text != blank or church.contact_email != blank %}
        <div class="clarity-footer-card rounded-2xl p-6 text-sm lg:w-80">
          {% if site.footer_text != blank %}<p class="whitespace-pre-line">{{ site.footer_text | escape }}</p>{% endif %}
          {% if church.contact_email != blank %}<p class="mt-3"><a href="mailto:{{ church.contact_email | escape }}" class="font-semibold underline underline-offset-4">{{ church.contact_email | escape }}</a></p>{% endif %}
        </div>
      {% endif %}
    </div>
    <div class="flex flex-col items-center justify-between gap-4 border-t border-(--site-border) py-8 text-sm md:flex-row">
      <ul class="flex gap-6 text-(--site-muted)">
        {% if site.facebook_url != blank %}<li><a href="{{ site.facebook_url | escape }}" class="hover:text-(--site-text)">Facebook</a></li>{% endif %}
        {% if site.instagram_url != blank %}<li><a href="{{ site.instagram_url | escape }}" class="hover:text-(--site-text)">Instagram</a></li>{% endif %}
        {% if site.youtube_url != blank %}<li><a href="{{ site.youtube_url | escape }}" class="hover:text-(--site-text)">YouTube</a></li>{% endif %}
      </ul>
      <p class="text-(--site-muted)">© {{ site.year }} {{ church.name | escape }}</p>
    </div>
  </footer>
</body>
</html>
