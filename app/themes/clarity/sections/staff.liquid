<section class="site-section clarity-section px-6 sm:px-12 lg:px-24">
  <h2 class="site-heading clarity-h2">{{ settings.heading | escape }}</h2>
  <ul class="mt-14 grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-4">
    {% for person in settings.blocks %}
      <li class="group">
        <div class="clarity-frame clarity-frame-sm">
          {% if person.photo_url != blank %}<img src="{{ person.photo_url | escape }}" alt="" class="aspect-[4/5] w-full rounded-xl object-cover transition duration-300 group-hover:scale-[1.02]" loading="lazy">{% else %}<div class="clarity-placeholder aspect-[4/5] rounded-xl"></div>{% endif %}
        </div>
        <p class="mt-5 font-semibold tracking-tight">{{ person.name | escape }}</p>
        {% if person.role != blank %}<p class="text-sm text-(--site-muted)">{{ person.role | escape }}</p>{% endif %}
        {% if person.email != blank %}<a href="mailto:{{ person.email | escape }}" class="mt-2 inline-flex items-center gap-1.5 text-sm text-(--site-muted) hover:text-(--site-text)"><svg viewBox="0 0 20 20" fill="none" class="h-4 w-4" aria-hidden="true"><rect x="2.75" y="4.75" width="14.5" height="10.5" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 6l6.5 5 6.5-5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>{{ person.email | escape }}</a>{% endif %}
      </li>
    {% endfor %}
  </ul>
</section>
