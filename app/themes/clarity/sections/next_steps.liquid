<section class="site-section clarity-section px-6 sm:px-12 lg:px-24">
  <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
    <h2 class="site-heading clarity-h2 lg:col-span-6">{{ settings.heading | escape }}</h2>
    {% if settings.intro != blank %}<p class="text-lg text-(--site-muted) lg:col-span-5 lg:col-start-8">{{ settings.intro | escape }}</p>{% endif %}
  </div>
  <ul class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {% for step in settings.blocks %}
      {% assign linked = false %}{% if step.link_label != blank and step.link_url != blank %}{% assign linked = true %}{% endif %}
      {% if forloop.first and step.image_url != blank %}
        <li class="clarity-bento-feature group relative isolate flex min-h-[22rem] flex-col justify-end overflow-hidden rounded-[2rem] p-8 md:col-span-2 lg:row-span-2 lg:min-h-[32rem]">
          <img src="{{ step.image_url | escape }}" alt="" class="absolute inset-0 -z-10 h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy">
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/80 via-black/25 to-transparent" aria-hidden="true"></div>
          <p class="site-heading text-3xl font-medium tracking-tight text-white sm:text-4xl">{{ step.title | escape }}</p>
          {% if step.text != blank %}<p class="mt-3 text-white/75">{{ step.text | escape }}</p>{% endif %}
          {% if linked %}<a href="{{ step.link_url | escape }}" class="site-button clarity-button clarity-button-light mt-6 self-start"><span class="absolute inset-0" aria-hidden="true"></span>{{ step.link_label | escape }}<svg viewBox="0 0 16 16" fill="none" class="h-4 w-4" aria-hidden="true"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>{% endif %}
        </li>
      {% else %}
        <li class="site-card clarity-card group relative flex flex-col">
          <div class="flex items-center justify-between">
            <span class="clarity-index">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            {% if linked %}<span class="clarity-arrow" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" class="h-4 w-4"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endif %}
          </div>
          {% if step.image_url != blank %}<img src="{{ step.image_url | escape }}" alt="" class="mt-6 aspect-[16/9] w-full rounded-xl object-cover" loading="lazy">{% endif %}
          <p class="mt-6 text-xl/7 font-semibold tracking-tight">{{ step.title | escape }}</p>
          {% if step.text != blank %}<p class="mt-2 text-[0.9375rem] text-(--site-muted)">{{ step.text | escape }}</p>{% endif %}
          {% if linked %}<a href="{{ step.link_url | escape }}" class="mt-auto pt-6 text-sm font-semibold"><span class="absolute inset-0" aria-hidden="true"></span>{{ step.link_label | escape }}</a>{% endif %}
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</section>
