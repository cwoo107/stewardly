<section class="site-section clarity-panel-wrap px-4 sm:px-6">
  <div class="clarity-panel relative isolate overflow-hidden px-6 py-16 sm:px-12 sm:py-20 lg:px-20">
    <div class="clarity-panel-glow" aria-hidden="true"></div>
    <div class="grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <span class="clarity-icon clarity-icon-dark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" class="h-5 w-5"><path d="M12 19.5s-7.5-4.35-7.5-9.75A4.25 4.25 0 0112 7.2a4.25 4.25 0 017.5 2.55c0 5.4-7.5 9.75-7.5 9.75z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></span>
        <h2 class="site-heading clarity-h2 mt-6 text-white">{{ settings.heading | escape }}</h2>
        <div class="site-prose clarity-prose-lg mt-4 text-white/70">{{ settings.body | markdown }}</div>
      </div>
      {% if church.giving_url != blank %}
        <div class="lg:col-span-5 lg:text-right"><a href="{{ church.giving_url | escape }}" class="site-button clarity-button clarity-button-light">{{ settings.button_label | escape }}<svg viewBox="0 0 16 16" fill="none" class="h-4 w-4" aria-hidden="true"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>
      {% endif %}
    </div>
  </div>
</section>
