<section class="site-section gv-section px-6 sm:px-12 lg:px-24">
  <header class="gv-head"><h2 class="site-heading gv-title">{{ settings.heading | escape }}</h2></header>
  {% if settings.intro != blank %}<p class="gv-lede -mt-4 mb-12 text-center">{{ settings.intro | escape }}</p>{% endif %}
  <ul class="gv-directory grid md:grid-cols-2 lg:grid-cols-3">
    {% for group in groups %}
      {% if settings.group_type == 'all' or settings.group_type == group.type_key %}
        <li class="gv-directory-entry flex flex-col">
          <p class="gv-smallcaps gv-gilt">{{ group.type }}</p>
          <p class="gv-name mt-2">{{ group.name | escape }}</p>
          <p class="gv-role">{{ group.meets | escape }}{% if group.area != blank %} · {{ group.area | escape }}{% endif %}</p>
          {% if group.description != blank %}<p class="mt-3">{{ group.description | escape | truncate: 160 }}</p>{% endif %}
          {% if group.full %}<p class="gv-muted mt-auto pt-4 italic">{{ settings.full_text | escape }}</p>{% else %}<a href="{{ group.join_url }}" class="gv-link mt-auto pt-4">{{ settings.join_label | escape }} →</a>{% endif %}
        </li>
      {% endif %}
    {% else %}
      <li class="gv-muted text-center italic md:col-span-2 lg:col-span-3">{{ settings.empty_text | escape }}</li>
    {% endfor %}
  </ul>
</section>
