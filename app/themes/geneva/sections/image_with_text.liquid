<section class="site-section gv-section px-6 sm:px-12 lg:px-24">
  <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5 {% if settings.image_side == 'right' %}lg:order-2 lg:col-start-8{% endif %}">
      {% if settings.image_url != blank %}<figure class="gv-plate"><img src="{{ settings.image_url | escape }}" alt="" class="aspect-[4/3] w-full object-cover" loading="lazy"></figure>{% else %}<div class="gv-plate"><div class="aspect-[4/3] bg-(--site-surface)"></div></div>{% endif %}
    </div>
    <div class="lg:col-span-7 {% if settings.image_side == 'right' %}lg:order-1{% endif %}">
      <header class="gv-head gv-head-left"><h2 class="site-heading gv-title">{{ settings.heading | escape }}</h2></header>
      <div class="site-prose gv-book gv-dropcap">{{ settings.body | markdown }}</div>
      {% if settings.button_label != blank and settings.button_url != blank %}<a href="{{ settings.button_url | escape }}" class="site-button gv-button mt-8">{{ settings.button_label | escape }}</a>{% endif %}
    </div>
  </div>
</section>
