<section class="site-section gv-section px-6 sm:px-12 lg:px-24">
  <div class="gv-colophon text-center">
    <p class="gv-orn" aria-hidden="true"><span>✦</span></p>
    <h2 class="site-heading gv-title gv-italic">{{ settings.heading | escape }}</h2>
    {% if settings.body != blank %}<p class="gv-lede mt-4">{{ settings.body | escape }}</p>{% endif %}
    {% if settings.button_label != blank and settings.button_url != blank %}<a href="{{ settings.button_url | escape }}" class="site-button gv-button mt-8">{{ settings.button_label | escape }}</a>{% endif %}
  </div>
</section>
