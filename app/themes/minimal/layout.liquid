<!doctype html>
<html lang="en">
<head>
  {{ head }}
</head>
<body class="site site-minimal">
  <header class="site-header flex flex-wrap items-baseline justify-between gap-4 px-6 py-8 sm:px-12 lg:px-24">
    <a href="/" class="font-semibold tracking-tight">{% if site.logo_url != blank %}<img src="{{ site.logo_url }}" alt="{{ site.name | escape }}" style="width: {{ site.logo_width }}px">{% else %}{{ site.name | escape }}{% endif %}</a>
    <nav aria-label="Main"><ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {% for link in site.nav %}<li><a href="{{ link.url }}" class="site-nav-link{% if link.current %} is-current{% endif %}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>{% endfor %}
    </ul></nav>
  </header>
  <main>{{ content_for_layout }}</main>
  <footer class="site-footer flex flex-wrap justify-between gap-4 border-t border-(--site-border) px-6 py-10 text-sm sm:px-12 lg:px-24">
    <span>© {{ site.year }} {{ church.name | escape }}</span>
    <span class="space-x-4">
      {% if site.facebook_url != blank %}<a href="{{ site.facebook_url | escape }}">Facebook</a>{% endif %}
      {% if site.instagram_url != blank %}<a href="{{ site.instagram_url | escape }}">Instagram</a>{% endif %}
      {% if site.youtube_url != blank %}<a href="{{ site.youtube_url | escape }}">YouTube</a>{% endif %}
    </span>
  </footer>
</body>
</html>
