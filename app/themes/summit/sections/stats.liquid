<section class="site-section summit-dark summit-glow px-6 py-20 sm:px-12 lg:px-24 lg:py-28">
  {% if settings.heading != blank %}<h2 class="site-heading summit-display summit-title mb-14">{{ settings.heading | escape }}</h2>{% endif %}
  <dl class="grid gap-y-12 sm:grid-cols-2 {% if settings.blocks.size >= 4 %}lg:grid-cols-4{% elsif settings.blocks.size == 3 %}lg:grid-cols-3{% endif %} lg:divide-x lg:divide-white/15">
    {% for stat in settings.blocks %}
      <div class="flex flex-col lg:px-10 lg:first:pl-0">
        <dt class="mt-4 text-sm font-bold uppercase tracking-[0.2em] text-(--site-muted)">{{ stat.label | escape }}</dt>
        <dd class="summit-display order-first text-[clamp(4rem,9vw,8rem)] text-(--site-accent)">{{ stat.number | escape }}</dd>
      </div>
    {% endfor %}
  </dl>
</section>
