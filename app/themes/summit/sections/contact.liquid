{% assign chosen = forms[settings.form] %}
<section class="site-section px-4 py-6 sm:px-6 lg:px-8">
  <div class="grid overflow-hidden rounded-[2.5rem] lg:grid-cols-12">
    <div class="summit-dark summit-glow px-6 py-16 sm:px-12 lg:px-14 lg:py-20 {% if chosen %}lg:col-span-5{% else %}lg:col-span-12{% endif %}">
      <h2 class="site-heading summit-display summit-title">{{ settings.heading | escape }}</h2>
      <div class="mt-12 space-y-8">
        {% for campus in campuses %}
          <div class="border-t border-(--site-border) pt-6">
            <p class="text-sm font-extrabold uppercase tracking-[0.2em] text-(--site-accent)">{{ campus.name | escape }}</p>
            {% if campus.map_url != blank %}<a href="{{ campus.map_url }}" class="group mt-3 flex items-start justify-between gap-4"><span class="whitespace-pre-line text-lg">{{ campus.address | escape }}</span><svg viewBox="0 0 20 20" fill="none" class="mt-1 h-5 w-5 flex-none transition group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true"><path d="M6 14 14 6m0 0H7m7 0v7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>{% else %}<p class="mt-3 whitespace-pre-line text-lg">{{ campus.address | escape }}</p>{% endif %}
          </div>
        {% endfor %}
        {% if church.contact_email != blank %}<a href="mailto:{{ church.contact_email | escape }}" class="block border-t border-(--site-border) pt-6 text-xl font-extrabold break-all hover:text-(--site-accent)">{{ church.contact_email | escape }}</a>{% endif %}
      </div>
    </div>
    {% if chosen %}<div class="site-form summit-soft px-6 py-16 sm:px-12 lg:col-span-7 lg:px-14 lg:py-20">{{ chosen.html }}</div>{% endif %}
  </div>
</section>
