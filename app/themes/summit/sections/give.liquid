<section class="site-section px-4 py-6 sm:px-6 lg:px-8">
  <div class="summit-accent relative isolate overflow-hidden rounded-[2.5rem] px-6 py-20 sm:px-12 lg:px-16 lg:py-28">
    <svg viewBox="0 0 400 400" fill="none" class="absolute -top-24 -right-24 -z-10 h-[28rem] w-[28rem] opacity-25" aria-hidden="true"><circle cx="200" cy="200" r="199" stroke="currentColor"/><circle cx="200" cy="200" r="140" stroke="currentColor"/><circle cx="200" cy="200" r="80" stroke="currentColor"/></svg>
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <h2 class="site-heading summit-display text-[clamp(3rem,8vw,7rem)] lg:col-span-7">{{ settings.heading | escape }}</h2>
      <div class="lg:col-span-5 lg:pb-3">
        <div class="site-prose summit-prose-lg font-medium">{{ settings.body | markdown }}</div>
        {% if church.giving_url != blank %}<a href="{{ church.giving_url | escape }}" class="site-button summit-button-ink mt-8">{{ settings.button_label | escape }} <svg viewBox="0 0 20 20" fill="none" class="h-5 w-5" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>{% endif %}
      </div>
    </div>
  </div>
</section>
