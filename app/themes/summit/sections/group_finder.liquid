<section class="site-section px-6 py-20 sm:px-12 lg:px-24 lg:py-32">
  <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
    <h2 class="site-heading summit-display summit-title lg:col-span-7">{{ settings.heading | escape }}</h2>
    {% if settings.intro != blank %}<p class="summit-lede lg:col-span-5">{{ settings.intro | escape }}</p>{% endif %}
  </div>
  <ul class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {% for group in groups %}
      {% if settings.group_type == 'all' or settings.group_type == group.type_key %}
        <li class="summit-card flex flex-col p-7">
          <span class="summit-pill self-start">{{ group.type }}</span>
          <p class="summit-display mt-6 text-2xl leading-tight tracking-tight">{{ group.name | escape }}</p>
          <p class="mt-2 font-semibold text-(--site-muted)">{{ group.meets | escape }}{% if group.area != blank %} · {{ group.area | escape }}{% endif %}</p>
          {% if group.description != blank %}<p class="mt-4 text-(--site-muted)">{{ group.description | escape | truncate: 160 }}</p>{% endif %}
          <div class="mt-auto pt-8">
            {% if group.full %}<p class="text-sm font-semibold text-(--site-muted)">{{ settings.full_text | escape }}</p>{% else %}<a href="{{ group.join_url }}" class="site-button">{{ settings.join_label | escape }} <svg viewBox="0 0 20 20" fill="none" class="h-5 w-5" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>{% endif %}
          </div>
        </li>
      {% endif %}
    {% else %}
      <li class="text-lg text-(--site-muted)">{{ settings.empty_text | escape }}</li>
    {% endfor %}
  </ul>
</section>
