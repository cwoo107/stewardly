<section class="site-section summit-soft px-6 py-20 sm:px-12 lg:px-24 lg:py-32">
  <h2 class="site-heading summit-display summit-title">{{ settings.heading | escape }}</h2>
  <ul class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {% for event in events limit: settings.count %}
      <li>
        <a href="{{ event.url }}" class="summit-card group flex h-full flex-col p-7">
          <div class="flex items-start justify-between gap-4">
            <div class="flex h-24 w-24 flex-none flex-col items-center justify-center rounded-[1.25rem] bg-(--summit-ink) text-white">
              <span class="text-xs font-extrabold uppercase tracking-[0.2em] text-(--site-accent)">{{ event.month }}</span>
              <span class="summit-display text-5xl">{{ event.day }}</span>
            </div>
            <span class="summit-arrow"><svg viewBox="0 0 20 20" fill="none" class="h-5 w-5" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </div>
          <p class="summit-display mt-8 text-2xl leading-tight tracking-tight sm:text-3xl">{{ event.title | escape }}</p>
          <p class="mt-3 text-(--site-muted)">{{ event.time }}{% if event.location != blank %} · {{ event.location | escape }}{% endif %}</p>
        </a>
      </li>
    {% else %}
      <li class="text-lg text-(--site-muted)">{{ settings.empty_text | escape }}</li>
    {% endfor %}
  </ul>
</section>
