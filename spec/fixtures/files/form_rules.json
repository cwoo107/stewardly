[
  { "name": "no conditions always shows", "rule": {}, "answers": {}, "expected": true },
  { "name": "equals matches case-insensitively", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "equals", "value": "Yes" } ] }, "answers": { "a": "yes" }, "expected": true },
  { "name": "equals fails on a different value", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "equals", "value": "Yes" } ] }, "answers": { "a": "No" }, "expected": false },
  { "name": "equals on a missing answer", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "equals", "value": "Yes" } ] }, "answers": {}, "expected": false },
  { "name": "not_equals on a missing answer", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "not_equals", "value": "Yes" } ] }, "answers": {}, "expected": true },
  { "name": "equals on a multi-select means one of the choices", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "equals", "value": "Serving" } ] }, "answers": { "a": [ "Baptism", "Serving" ] }, "expected": true },
  { "name": "contains is a substring for text", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "contains", "value": "PRAY" } ] }, "answers": { "a": "please pray for me" }, "expected": true },
  { "name": "contains on a multi-select", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "contains", "value": "Serving" } ] }, "answers": { "a": [ "Baptism" ] }, "expected": false },
  { "name": "filled with text", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "filled", "value": "" } ] }, "answers": { "a": "x" }, "expected": true },
  { "name": "filled with an empty string", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "filled", "value": "" } ] }, "answers": { "a": "" }, "expected": false },
  { "name": "filled with an empty multi-select", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "filled", "value": "" } ] }, "answers": { "a": [] }, "expected": false },
  { "name": "ticked checkbox is filled", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "filled", "value": "" } ] }, "answers": { "a": "true" }, "expected": true },
  { "name": "empty on a missing answer", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "empty", "value": "" } ] }, "answers": {}, "expected": true },
  { "name": "greater_than compares numbers, not text", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "greater_than", "value": "9" } ] }, "answers": { "a": "10" }, "expected": true },
  { "name": "less_than with decimals", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "less_than", "value": "2.5" } ] }, "answers": { "a": ".5" }, "expected": true },
  { "name": "greater_than compares ISO dates", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "greater_than", "value": "2026-01-01" } ] }, "answers": { "a": "2026-03-15" }, "expected": true },
  { "name": "numbers don't compare with text", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "greater_than", "value": "9" } ] }, "answers": { "a": "ten" }, "expected": false },
  { "name": "underscored and hex numbers aren't numbers", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "greater_than", "value": "5" } ] }, "answers": { "a": "1_000" }, "expected": false },
  { "name": "greater_than on an empty answer", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "less_than", "value": "5" } ] }, "answers": { "a": "" }, "expected": false },
  { "name": "all needs every condition", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "filled", "value": "" }, { "field": "b", "operator": "equals", "value": "x" } ] }, "answers": { "a": "1", "b": "y" }, "expected": false },
  { "name": "any needs one condition", "rule": { "match": "any", "conditions": [ { "field": "a", "operator": "filled", "value": "" }, { "field": "b", "operator": "equals", "value": "x" } ] }, "answers": { "a": "", "b": "x" }, "expected": true },
  { "name": "unknown operator never holds", "rule": { "match": "all", "conditions": [ { "field": "a", "operator": "resembles", "value": "x" } ] }, "answers": { "a": "x" }, "expected": false }
